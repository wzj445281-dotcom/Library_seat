# ==========================
# IDE & 操作系统 (System)
# ==========================
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp

# ==========================
# Java / Maven 后端
# ==========================
**/target/
*.class

# Maven Wrapper
.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

# 日志文件
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Spring Boot / 常用工具生成文件
help.md
_site/
dependency-reduced-pom.xml

# ==========================
# Vue / 前端通用
# ==========================
**/node_modules/
**/dist/
**/dist-ssr/

# 本地环境配置
.env.local
.env.*.local

# ESLint 缓存
.eslintcache

# 单元测试覆盖率报告
coverage/

# 编辑器目录 (如果在前端项目里有)
.editorconfig

# ==========================
# 微信小程序特定
# ==========================
project.private.config.json
cloudfunctions/*/localconfig.json
**/miniprogram_npm/
*.upload

# ==========================
# Docker & 运行时数据 (CRITICAL)
# ==========================
# 数据库持久化数据
mysql_data/
mongo_data/
redis_data/

# 用户上传的文件
uploads/
**/public/uploads/

# 临时文件
tmp/
temp/

# 打包文件（除了Maven wrapper的jar）
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# ==========================
# IDE 配置（选择性提交）
# ==========================
# 以下文件通常不提交，但有些人选择提交
# .vscode/settings.json
# .vscode/extensions.json
# .idea/codeStyles/
# .idea/inspectionProfiles/

# ==========================
# 确保这些重要文件不被忽略
# ==========================
!.mvn/wrapper/maven-wrapper.properties
!mvnw
!mvnw.cmd
!.vscode/settings.json.example  # 如果有示例配置
!.idea/codeStyles/Project.xml   # 如果有团队代码风格配置
# ==========================
# Python (新增 - AI服务必须忽略)
# ==========================
# 字节码缓存 (非常重要，否则到处都是 __pycache__ 文件夹)
__pycache__/
*.py[cod]
*$py.class

# Python 虚拟环境 (如果你在本地创建了虚拟环境)
venv/
.venv/
env/
.env/

# PyCharm / IDE 缓存
.idea/

# Jupyter Notebook (如果用了的话)
.ipynb_checkpoints