<view class="container">
    <!-- 用户信息卡片 -->
    <view class="user-card">
        <image class="avatar" src="{{userInfo.avatarUrl || '/assets/images/default_avatar.png'}}" mode="cover"></image>
        <view class="info">
            <view class="nickname">{{userInfo.nickName || '点击登录'}}</view>
            <view class="vip-tag" wx:if="{{userInfo.isVip}}">萌宠VIP会员</view>
            <view class="vip-tag normal" wx:else>普通会员</view>
        </view>
    </view>

    <!-- 钱包余额 -->
    <view class="wallet-card">
        <view class="balance-item">
            <text class="num">{{userInfo.balance || 0}}</text>
            <text class="label">余额</text>
        </view>
        <view class="balance-item" bindtap="goToCredit">
            <text class="num">{{userInfo.credit || 100}}</text>
            <text class="label">信用分</text>
        </view>
        <view class="recharge-btn" bindtap="handleRecharge">充值</view>
    </view>

    <!-- 菜单列表 -->
    <view class="menu-list">
        <view class="menu-item" bindtap="goToOrders">
            <view class="left">
                <image class="icon" src="/assets/icons/order.png"></image>
                <text>我的订单</text>
            </view>
            <text class="arrow">></text>
        </view>

        <view class="menu-item" bindtap="goToFeedback">
            <view class="left">
                <image class="icon" src="/assets/icons/feedback.png"></image>
                <text>意见反馈</text>
            </view>
            <text class="arrow">></text>
        </view>

        <view class="menu-item" bindtap="handleContact">
            <view class="left">
                <image class="icon" src="/assets/icons/service.png"></image>
                <text>联系客服</text>
            </view>
            <text class="arrow">></text>
        </view>

        <view class="menu-item" bindtap="handleLogout" wx:if="{{isLogin}}">
            <view class="left">
                <image class="icon" src="/assets/icons/logout.png"></image>
                <text>退出登录</text>
            </view>
            <text class="arrow">></text>
        </view>
    </view>
</view>