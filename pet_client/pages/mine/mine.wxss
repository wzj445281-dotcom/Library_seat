page { background-color: #f7f8fa; padding-bottom: 40rpx; }

.header-card {
    background: #1296db;
    padding: 50rpx 40rpx;
    display: flex; align-items: center; color: white;
    margin-bottom: 30rpx;
}
.avatar-box {
    width: 100rpx; height: 100rpx; background: rgba(255,255,255,0.2);
    border-radius: 50%; display: flex; justify-content: center; align-items: center; margin-right: 30rpx;
}
.avatar { width: 60rpx; height: 60rpx; }
.name { font-size: 34rpx; font-weight: bold; }
.credit-tag { font-size: 24rpx; background: rgba(0,0,0,0.1); padding: 4rpx 16rpx; border-radius: 20rpx; margin-top: 10rpx; display: inline-block; }

.list-container { padding: 0 30rpx; }
.section-title { font-size: 30rpx; font-weight: bold; margin-bottom: 20rpx; padding-left: 10rpx; border-left: 8rpx solid #1296db; }

.empty-tip { text-align: center; color: #999; margin-top: 50rpx; font-size: 28rpx; }

/* 订单卡片 */
.order-card {
    background: white; border-radius: 16rpx; padding: 30rpx; margin-bottom: 24rpx;
    box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}
.card-header { display: flex; justify-content: space-between; border-bottom: 1px solid #f5f5f5; padding-bottom: 20rpx; margin-bottom: 20rpx; }
.time { font-size: 28rpx; font-weight: bold; color: #333; }
.status { font-size: 26rpx; }
.status.blue { color: #1890ff; }
.status.green { color: #52c41a; }
.status.gray { color: #999; }

.card-body { font-size: 26rpx; color: #666; line-height: 1.6; }
.card-footer { display: flex; justify-content: flex-end; margin-top: 20rpx; gap: 20rpx; }

.mini-btn { font-size: 24rpx; padding: 0 30rpx; line-height: 50rpx; border-radius: 25rpx; }
.mini-btn.cancel { background: #fff; color: #666; border: 1px solid #ddd; }
.mini-btn.checkin { background: #1296db; color: #fff; }

.btn-area { margin-top: 60rpx; padding: 0 40rpx; }
.btn-logout { background: white; color: #ff4d4f; border-radius: 40rpx; font-size: 30rpx; }