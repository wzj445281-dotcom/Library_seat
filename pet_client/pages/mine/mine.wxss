.container {
    min-height: 100vh;
    background-color: #f5f7fa;
    padding-bottom: 40rpx;
}

.user-header {
    background-color: #1296db;
    padding: 60rpx 40rpx;
    display: flex;
    align-items: center;
    color: #fff;
}

.avatar {
    width: 120rpx;
    height: 120rpx;
    border-radius: 50%;
    border: 4rpx solid rgba(255,255,255,0.3);
    margin-right: 30rpx;
    background-color: #fff;
}

.nickname {
    font-size: 36rpx;
    font-weight: bold;
}

.status {
    font-size: 24rpx;
    background-color: rgba(0,0,0,0.1);
    padding: 4rpx 12rpx;
    border-radius: 8rpx;
    margin-top: 10rpx;
    display: inline-block;
}

.menu-grid {
    display: flex;
    background: #fff;
    padding: 30rpx 0;
    margin-bottom: 20rpx;
}

.menu-item {
    flex: 1;
    text-align: center;
    font-size: 28rpx;
    color: #333;
}

.section-title {
    padding: 20rpx 30rpx;
    font-size: 30rpx;
    font-weight: bold;
    color: #333;
}

.reservation-list {
    padding: 0 30rpx;
}

.res-card {
    background-color: #fff;
    border-radius: 12rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02);
}

.res-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 16rpx;
}

.res-doctor {
    font-weight: bold;
    color: #333;
}

.res-status {
    font-size: 24rpx;
}

.res-status.confirmed {
    color: #52c41a;
}

.res-time {
    font-size: 28rpx;
    color: #666;
    margin-bottom: 8rpx;
}

.res-tips {
    font-size: 24rpx;
    color: #999;
}

.empty-res {
    text-align: center;
    color: #999;
    padding: 40rpx 0;
    font-size: 26rpx;
}

.btn-logout {
    margin-top: 60rpx;
    background-color: #fff;
    color: #ff4d4f;
    font-weight: normal;
}