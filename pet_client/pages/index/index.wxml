<view class="container">
  <!-- 顶部搜索栏 (装饰) -->
  <view class="search-bar">
    <view class="search-input">
      <text class="placeholder">搜索医生、服务或商品...</text>
    </view>
  </view>

  <!-- 轮播图 -->
  <swiper class="banner-swiper" indicator-dots autoplay interval="5000" circular>
    <block wx:for="{{banners}}" wx:key="id">
      <swiper-item>
        <image src="{{item.img}}" class="banner-img" mode="aspectFill"></image>
      </swiper-item>
    </block>
  </swiper>

  <!-- 金刚区导航 -->
  <view class="menu-grid">
    <view class="menu-item" wx:for="{{menuList}}" wx:key="name" bindtap="onMenuTap" data-url="{{item.url}}">
      <view class="menu-icon-box" style="background-color: {{item.color}}">
        <!-- 暂时用首字代替图标，正式上线请换 image -->
        <text class="menu-icon-text">{{item.name[0]}}</text>
      </view>
      <text class="menu-text">{{item.name}}</text>
    </view>
  </view>

  <!-- 热门医生 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">名医推荐</text>
      <text class="section-more" bindtap="onMenuTap" data-url="/pages/doctor/list/list">全部 ></text>
    </view>
    <scroll-view class="doctor-scroll" scroll-x enable-flex>
      <view class="doctor-card" wx:for="{{recommendDoctors}}" wx:key="id">
        <image class="doc-avatar" src="{{item.avatar || 'https://via.placeholder.com/100'}}" mode="aspectFill"></image>
        <text class="doc-name">{{item.name}}</text>
        <text class="doc-title">{{item.title}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 严选好物 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">严选好物</text>
    </view>
    <view class="product-grid">
      <view class="product-item" wx:for="{{hotProducts}}" wx:key="id" bindtap="toProductDetail" data-id="{{item.id}}">
        <image class="prod-img" src="{{item.image || 'https://via.placeholder.com/200'}}" mode="aspectFill"></image>
        <view class="prod-info">
          <text class="prod-name">{{item.name}}</text>
          <text class="prod-price">¥{{item.price}}</text>
        </view>
      </view>
      <!-- 缺省展示，如果没数据 -->
      <view class="empty-tip" wx:if="{{hotProducts.length === 0}}">
        <text>暂无商品上架</text>
      </view>
    </view>
  </view>
</view>