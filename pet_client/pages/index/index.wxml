<view class="container"> 
  <!-- 顶部搜索栏 (装饰用) --> 
  <view class="search-bar"> 
    <view class="search-input"> 
      <icon type="search" size="14"></icon> 
      <text>搜索宠物零食/玩具</text> 
    </view> 
  </view> 
 
  <!-- 轮播图 --> 
  <swiper class="banner" indicator-dots="{{true}}" autoplay="{{true}}" interval="3000" circular="{{true}}"> 
    <block wx:for="{{banners}}" wx:key="*this"> 
      <swiper-item> 
        <image src="{{item}}" mode="aspectFill" class="banner-image"/> 
      </swiper-item> 
    </block> 
  </swiper> 
 
  <!-- 分类导航 --> 
  <scroll-view scroll-x class="category-nav" enable-flex> 
    <view 
      wx:for="{{categories}}" 
      wx:key="id" 
      class="category-item {{currentCategory === item.id ? 'active' : ''}}" 
      bindtap="switchCategory" 
      data-id="{{item.id}}" 
    > 
      <text>{{item.name}}</text> 
      <view class="indicator" wx:if="{{currentCategory === item.id}}"></view> 
    </view> 
  </scroll-view> 
 
  <!-- 商品列表 --> 
  <view class="product-list"> 
    <block wx:if="{{loading}}"> 
      <view class="loading-state">加载中...</view> 
    </block> 
    
    <block wx:elif="{{productList.length > 0}}"> 
      <view class="product-card" wx:for="{{productList}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}"> 
        <image src="{{item.image}}" mode="aspectFill" class="product-img"/> 
        <view class="product-info"> 
          <view class="product-name">{{item.name}}</view> 
          <view class="product-tags"> 
            <text class="tag">自营</text> 
            <text class="sales">已售 {{item.sales}}+</text> 
          </view> 
          <view class="price-row"> 
            <text class="price">¥{{item.price}}</text> 
            <view class="add-btn" catchtap="handleBuy" data-item="{{item}}"> 
              <text>购买</text> 
            </view> 
          </view> 
        </view> 
      </view> 
    </block> 
 
    <block wx:else> 
      <view class="empty-state"> 
        <image src="/assets/images/seat.png" mode="widthFix" style="width: 100rpx; opacity: 0.3;"></image> 
        <text>该分类下暂无商品</text> 
      </view> 
    </block> 
  </view> 
</view>