page { 
  background-color: #f7f8fa; 
} 
 
.container { 
  padding-bottom: 40rpx; 
} 
 
/* 搜索栏 */ 
.search-bar { 
  background: #fff; 
  padding: 20rpx 30rpx; 
  position: sticky; 
  top: 0; 
  z-index: 100; 
} 
 
.search-input { 
  background: #f0f0f0; 
  height: 64rpx; 
  border-radius: 32rpx; 
  display: flex; 
  align-items: center; 
  padding: 0 24rpx; 
  color: #999; 
  font-size: 26rpx; 
} 
 
.search-input icon { 
  margin-right: 12rpx; 
} 
 
/* 轮播图 */ 
.banner { 
  height: 300rpx; 
  margin: 20rpx 30rpx; 
  border-radius: 16rpx; 
  overflow: hidden; 
} 
 
.banner-image { 
  width: 100%; 
  height: 100%; 
} 
 
/* 分类导航 */ 
.category-nav { 
  background: #fff; 
  white-space: nowrap; 
  padding: 0 10rpx; 
  height: 88rpx; 
  display: flex; 
} 
 
.category-item { 
  display: inline-flex; 
  flex-direction: column; 
  align-items: center; 
  justify-content: center; 
  padding: 0 30rpx; 
  height: 100%; 
  position: relative; 
  font-size: 28rpx; 
  color: #666; 
} 
 
.category-item.active { 
  color: #FF6B00; 
  font-weight: bold; 
  font-size: 30rpx; 
} 
 
.indicator { 
  position: absolute; 
  bottom: 10rpx; 
  width: 40rpx; 
  height: 4rpx; 
  background: #FF6B00; 
  border-radius: 2rpx; 
} 
 
/* 商品列表 - 两列布局 */ 
.product-list { 
  padding: 20rpx 30rpx; 
  display: flex; 
  flex-wrap: wrap; 
  justify-content: space-between; 
} 
 
.product-card { 
  width: 48%; 
  background: #fff; 
  border-radius: 16rpx; 
  margin-bottom: 24rpx; 
  overflow: hidden; 
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.03); 
} 
 
.product-img { 
  width: 100%; 
  height: 340rpx; 
  background: #f9f9f9; 
} 
 
.product-info { 
  padding: 16rpx; 
} 
 
.product-name { 
  font-size: 28rpx; 
  color: #333; 
  line-height: 1.4; 
  height: 80rpx; /* 限制两行高度 */ 
  overflow: hidden; 
  text-overflow: ellipsis; 
  display: -webkit-box; 
  -webkit-line-clamp: 2; 
  -webkit-box-orient: vertical; 
} 
 
.product-tags { 
  margin-top: 10rpx; 
  display: flex; 
  align-items: center; 
} 
 
.tag { 
  font-size: 20rpx; 
  color: #fff; 
  background: #FF6B00; 
  padding: 2rpx 8rpx; 
  border-radius: 4rpx; 
  margin-right: 10rpx; 
} 
 
.sales { 
  font-size: 22rpx; 
  color: #999; 
} 
 
.price-row { 
  display: flex; 
  align-items: center; 
  justify-content: space-between; 
  margin-top: 16rpx; 
} 
 
.price { 
  font-size: 32rpx; 
  color: #FF4400; 
  font-weight: bold; 
} 
 
.add-btn { 
  background: #FF4400; 
  color: #fff; 
  font-size: 24rpx; 
  padding: 8rpx 20rpx; 
  border-radius: 24rpx; 
} 
 
.loading-state, .empty-state { 
  width: 100%; 
  text-align: center; 
  padding: 100rpx 0; 
  color: #999; 
  font-size: 26rpx; 
  display: flex; 
  flex-direction: column; 
  align-items: center; 
  gap: 20rpx; 
}