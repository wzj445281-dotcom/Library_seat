<view class="container">
  <view class="header">
    <text class="title">专家团队</text>
    <text class="subtitle">专业兽医为您提供最优质的医疗服务</text>
  </view>

  <view class="doctor-list" wx:if="{{!loading}}">
    <block wx:for="{{doctorList}}" wx:key="id">
      <view class="doctor-card">
        <image class="avatar" src="{{item.avatar}}" mode="aspectFill"></image>
        <view class="info">
          <view class="name-row">
            <text class="name">{{item.name}}</text>
            <text class="title-tag">{{item.title}}</text>
          </view>
          <text class="specialty">擅长：{{item.specialty}}</text>
          <text class="desc">{{item.introduction}}</text>

          <view class="action-row">
            <button class="btn-chat" size="mini" bindtap="toConsult" data-name="{{item.name}}">咨询</button>
            <button class="btn-book" size="mini" bindtap="toBook" data-id="{{item.id}}">预约</button>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="loading" wx:else>
    <text>加载中...</text>
  </view>

  <view class="empty" wx:if="{{!loading && doctorList.length === 0}}">
    <text>暂无医生排班信息</text>
  </view>
</view>