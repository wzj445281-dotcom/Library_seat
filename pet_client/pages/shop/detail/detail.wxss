.container {
    background-color: #f5f7fa;
    padding-bottom: 120rpx;
    min-height: 100vh;
}

.swiper {
    width: 100%;
    height: 750rpx;
    background-color: #fff;
}

.slide-image {
    width: 100%;
    height: 100%;
}

.info-section {
    background-color: #fff;
    padding: 30rpx;
    margin-bottom: 20rpx;
}

.price-row {
    display: flex;
    align-items: baseline;
    margin-bottom: 16rpx;
}

.currency {
    font-size: 28rpx;
    color: #ff4d4f;
    font-weight: bold;
}

.price {
    font-size: 48rpx;
    color: #ff4d4f;
    font-weight: bold;
    margin-left: 4rpx;
}

.original-price {
    font-size: 24rpx;
    color: #999;
    text-decoration: line-through;
    margin-left: 16rpx;
}

.title {
    font-size: 34rpx;
    font-weight: bold;
    color: #333;
    line-height: 1.4;
    margin-bottom: 16rpx;
}

.sub-info {
    display: flex;
    justify-content: space-between;
    font-size: 24rpx;
    color: #999;
}

.section {
    background-color: #fff;
    padding: 30rpx;
    margin-bottom: 20rpx;
}

.cell {
    display: flex;
    align-items: center;
}

.label {
    font-size: 28rpx;
    color: #999;
    width: 80rpx;
}

.value {
    flex: 1;
    font-size: 28rpx;
    color: #333;
}

.arrow {
    color: #ccc;
    font-family: monospace;
}

.detail-section {
    background-color: #fff;
    padding: 30rpx;
    min-height: 400rpx;
}

.section-title {
    font-size: 30rpx;
    font-weight: bold;
    margin-bottom: 24rpx;
    border-left: 8rpx solid #1296db;
    padding-left: 16rpx;
}

.desc-text {
    font-size: 28rpx;
    color: #666;
    line-height: 1.6;
}

.mock-detail-img {
    height: 300rpx;
    background-color: #f9f9f9;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ccc;
    margin-top: 30rpx;
    border: 2rpx dashed #eee;
}

/* 底部栏 */
.footer-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 110rpx;
    background-color: #fff;
    display: flex;
    align-items: center;
    padding: 0 20rpx;
    box-sizing: border-box;
    box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
    z-index: 99;
}

.icon-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100rpx;
    font-size: 20rpx;
    color: #666;
}

.icon {
    font-size: 36rpx;
    margin-bottom: 4rpx;
}

.btn-group {
    flex: 1;
    display: flex;
    margin-left: 20rpx;
}

.btn-cart {
    flex: 1;
    background-color: #ffcd00;
    color: #fff;
    font-size: 28rpx;
    border-radius: 40rpx 0 0 40rpx;
    margin: 0;
    line-height: 80rpx;
}

.btn-buy {
    flex: 1;
    background-color: #ff4d4f;
    color: #fff;
    font-size: 28rpx;
    border-radius: 0 40rpx 40rpx 0;
    margin: 0;
    line-height: 80rpx;
}