<view class="container" wx:if="{{!loading}}">
    <!-- 商品轮播图 (暂时只有一张图) -->
    <swiper class="swiper" indicator-dots autoplay circular>
        <swiper-item>
            <image src="{{product.image || 'https://via.placeholder.com/750x750'}}" class="slide-image" mode="aspectFill" />
        </swiper-item>
    </swiper>

    <!-- 价格与标题 -->
    <view class="info-section">
        <view class="price-row">
            <text class="currency">¥</text>
            <text class="price">{{product.price}}</text>
            <text class="original-price" wx:if="{{product.originalPrice}}">¥{{product.originalPrice}}</text>
        </view>
        <view class="title">{{product.name}}</view>
        <view class="sub-info">
            <text>库存: {{product.stock || 999}}</text>
            <text>销量: {{product.sales || 0}}</text>
        </view>
    </view>

    <!-- 规格选择 (静态展示) -->
    <view class="section cell">
        <text class="label">选择</text>
        <text class="value">默认规格</text>
        <text class="arrow">></text>
    </view>

    <!-- 商品详情 -->
    <view class="detail-section">
        <view class="section-title">商品详情</view>
        <view class="content">
            <!-- 如果后端返回富文本，这里用 rich-text，目前先简单展示描述 -->
            <text class="desc-text">{{product.description || '暂无详细描述，但它绝对值得拥有！'}}</text>

            <!-- 模拟长图 -->
            <view class="mock-detail-img">
                <text>--- 商品详情图展示区 ---</text>
            </view>
        </view>
    </view>

    <!-- 底部操作栏 -->
    <view class="footer-bar safe-area-bottom">
        <view class="icon-btn" bindtap="contactService">
            <view class="icon">🎧</view>
            <text>客服</text>
        </view>
        <view class="icon-btn">
            <view class="icon">🛒</view>
            <text>购物车</text>
        </view>
        <view class="btn-group">
            <button class="btn-cart">加入购物车</button>
            <button class="btn-buy" bindtap="handleBuy" loading="{{submitting}}">立即购买</button>
        </view>
    </view>
</view>