.container {
    min-height: 100vh;
    background-color: #f7f8fa;
}

/* 搜索栏 */
.search-wrapper {
    background-color: #fff;
    padding: 20rpx 30rpx;
    position: sticky;
    top: 0;
    z-index: 99;
}

.search-bar {
    background-color: #f2f2f2;
    height: 72rpx;
    border-radius: 36rpx;
    display: flex;
    align-items: center;
    padding: 0 24rpx;
}

.search-bar input {
    flex: 1;
    margin-left: 16rpx;
    font-size: 28rpx;
    color: #333;
}

.ph-color {
    color: #999;
}

/* 分类 Tabs */
.category-scroll {
    background-color: #fff;
    white-space: nowrap;
    height: 90rpx;
    display: flex;
    padding: 0 20rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.02);
}

.cat-item {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 30rpx;
    height: 100%;
    font-size: 28rpx;
    color: #666;
    position: relative;
}

.cat-item.active {
    color: #1296db;
    font-weight: bold;
    font-size: 30rpx;
}

.indicator {
    position: absolute;
    bottom: 10rpx;
    width: 40rpx;
    height: 4rpx;
    background-color: #1296db;
    border-radius: 2rpx;
}

/* 商品列表 */
.product-list {
    padding: 20rpx;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
}

.prod-card {
    width: 48.5%;
    background-color: #fff;
    border-radius: 16rpx;
    overflow: hidden;
    margin-bottom: 20rpx;
    padding-bottom: 20rpx;
    box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}

.prod-img {
    width: 100%;
    height: 340rpx;
    background-color: #eee;
}

.prod-info {
    padding: 16rpx 20rpx 0;
}

.prod-title {
    font-size: 28rpx;
    color: #333;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    height: 80rpx;
    line-height: 40rpx;
}

.prod-tags {
    margin-top: 10rpx;
}

.tag {
    font-size: 20rpx;
    color: #ff9800;
    border: 1rpx solid #ff9800;
    padding: 2rpx 8rpx;
    border-radius: 6rpx;
}

.price-row {
    margin-top: 16rpx;
    display: flex;
    align-items: baseline;
}

.currency {
    font-size: 24rpx;
    color: #ff4d4f;
    font-weight: bold;
}

.price {
    font-size: 36rpx;
    color: #ff4d4f;
    font-weight: bold;
    margin-left: 4rpx;
}

.sales {
    font-size: 22rpx;
    color: #999;
    margin-left: auto;
}

.loading-state, .no-more, .empty-state {
    text-align: center;
    color: #999;
    padding: 30rpx 0;
    font-size: 24rpx;
    width: 100%;
}

.empty-icon {
    width: 200rpx;
    margin-bottom: 20rpx;
}