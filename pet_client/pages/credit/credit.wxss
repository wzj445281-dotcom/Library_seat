page { background: #f7f8fa; }

.header {
    background: #1296db;
    color: white;
    padding: 60rpx;
    text-align: center;
}
.score-num { font-size: 80rpx; font-weight: bold; margin-top: 20rpx; }

.log-list { padding: 30rpx; }
.section-title { font-weight: bold; margin-bottom: 20rpx; font-size: 30rpx; }

.log-item {
    background: white;
    padding: 30rpx;
    border-radius: 12rpx;
    margin-bottom: 20rpx;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.03);
}

.reason { font-size: 30rpx; color: #333; margin-bottom: 10rpx; }
.date { font-size: 24rpx; color: #999; }

.log-right { font-size: 36rpx; font-weight: bold; }
.log-right.add { color: #52c41a; }
.log-right.reduce { color: #ff4d4f; }

.empty { text-align: center; color: #999; margin-top: 50rpx; }