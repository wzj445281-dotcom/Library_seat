page { background: #f7f8fa; padding: 30rpx; }

.header-tip {
    font-size: 28rpx; color: #999; margin-bottom: 30rpx;
}

.form-group {
    background: white; border-radius: 12rpx; padding: 30rpx; margin-bottom: 30rpx;
    position: relative;
}

.content-input {
    width: 100%; height: 200rpx; font-size: 30rpx;
}

.word-count {
    text-align: right; color: #ccc; font-size: 24rpx; margin-top: 10rpx;
}

.contact-input {
    height: 60rpx; font-size: 30rpx;
}

.btn-submit {
    background: #1296db; color: white; border-radius: 50rpx; margin-top: 60rpx;
    font-weight: bold;
}