.container {
    min-height: 100vh;
    background-color: #f5f7fa;
    padding-bottom: 120rpx; /* 为底部栏留空 */
}

/* 医生头部 */
.doctor-header {
    background-color: #fff;
    padding: 30rpx;
    display: flex;
    align-items: center;
}

.avatar {
    width: 100rpx;
    height: 100rpx;
    border-radius: 50%;
    margin-right: 24rpx;
    background-color: #eee;
}

.info {
    display: flex;
    flex-direction: column;
}

.name {
    font-size: 34rpx;
    font-weight: bold;
    color: #333;
}

.title {
    font-size: 24rpx;
    color: #666;
    margin-top: 4rpx;
}

.tips {
    font-size: 22rpx;
    color: #999;
    margin-top: 8rpx;
}

/* 日历条 */
.calendar-scroll {
    white-space: nowrap;
    background-color: #fff;
    padding: 20rpx 0;
    margin-top: 2rpx;
    box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.03);
    display: flex;
    height: 140rpx;
}

.date-item {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 110rpx;
    height: 110rpx;
    margin: 0 10rpx;
    border-radius: 16rpx;
    background-color: #f8f8f8;
    color: #333;
    transition: all 0.3s;
}

.date-item:first-child {
    margin-left: 20rpx;
}

.date-item:last-child {
    margin-right: 20rpx;
}

.date-item.active {
    background-color: #1296db;
    color: #fff;
    box-shadow: 0 4rpx 12rpx rgba(18, 150, 219, 0.4);
    transform: scale(1.05);
}

.week {
    font-size: 24rpx;
    margin-bottom: 8rpx;
}

.day {
    font-size: 32rpx;
    font-weight: bold;
}

/* 时间槽区域 */
.slot-container {
    margin-top: 20rpx;
    background-color: #fff;
    padding: 30rpx;
    min-height: 500rpx;
}

.section-title {
    font-size: 30rpx;
    font-weight: bold;
    margin-bottom: 24rpx;
    border-left: 8rpx solid #1296db;
    padding-left: 16rpx;
}

.slot-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20rpx;
}

.slot-item {
    height: 80rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #fff;
    border: 2rpx solid #e0e0e0;
    border-radius: 12rpx;
    font-size: 28rpx;
    color: #333;
}

.slot-item.selected {
    background-color: #e6f7ff;
    border-color: #1296db;
    color: #1296db;
    font-weight: bold;
}

.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 60rpx;
    color: #999;
    font-size: 26rpx;
}

.empty-img {
    width: 200rpx;
    margin-bottom: 20rpx;
}

/* 底部栏 */
.footer-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 110rpx;
    background-color: #fff;
    box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
    display: flex;
    align-items: center;
    padding: 0 30rpx;
    box-sizing: border-box;
    z-index: 99;
}

.selected-info {
    flex: 1;
    font-size: 28rpx;
    color: #666;
}

.highlight {
    color: #1296db;
    font-weight: bold;
    margin-left: 10rpx;
}

.btn-submit {
    width: 240rpx !important;
    height: 80rpx;
    line-height: 80rpx;
    background-color: #1296db;
    color: #fff;
    border-radius: 40rpx;
    font-size: 30rpx;
    margin: 0;
    padding: 0;
}

.btn-submit[disabled] {
    background-color: #ccc !important;
    color: #fff !important;
}