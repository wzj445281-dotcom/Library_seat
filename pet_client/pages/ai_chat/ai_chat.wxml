<view class="chat-container">
    <scroll-view scroll-y class="msg-list" scroll-top="{{scrollTop}}">
        <block wx:for="{{messages}}" wx:key="index">
            <!-- AI 消息 -->
            <view class="msg-item ai" wx:if="{{item.type === 'ai'}}">
                <view class="avatar">🤖</view>
                <view class="bubble">{{item.content}}</view>
            </view>
            <!-- 用户消息 -->
            <view class="msg-item user" wx:else>
                <view class="bubble">{{item.content}}</view>
                <view class="avatar">👤</view>
            </view>
        </block>
        <view wx:if="{{loading}}" class="loading-tip">AI 正在思考中...</view>
    </scroll-view>

    <view class="input-area">
        <input class="input" placeholder="输入您的问题..."
               value="{{inputVal}}" bindinput="handleInput" bindconfirm="handleSend"/>
        <button class="btn-send" bindtap="handleSend" disabled="{{loading}}">发送</button>
    </view>
</view>