page { background: #f2f2f2; height: 100%; }
.chat-container { display: flex; flex-direction: column; height: 100vh; }
.msg-list { flex: 1; padding: 20rpx; box-sizing: border-box; }

.msg-item { display: flex; margin-bottom: 30rpx; align-items: flex-start; }
.msg-item.user { justify-content: flex-end; }
.avatar { width: 80rpx; height: 80rpx; background: #ddd; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 40rpx; }
.msg-item.ai .avatar { background: #1296db; color: white; margin-right: 20rpx; }
.msg-item.user .avatar { background: #ffcc00; margin-left: 20rpx; }

.bubble { max-width: 60%; padding: 20rpx; border-radius: 12rpx; font-size: 28rpx; line-height: 1.5; position: relative; }
.msg-item.ai .bubble { background: white; color: #333; }
.msg-item.user .bubble { background: #95ec69; color: black; }

.loading-tip { text-align: center; color: #999; font-size: 24rpx; padding: 20rpx; }

.input-area { background: white; padding: 20rpx; display: flex; align-items: center; border-top: 1rpx solid #e5e5e5; }
.input { flex: 1; background: #f7f7f7; height: 70rpx; border-radius: 10rpx; padding: 0 20rpx; margin-right: 20rpx; font-size: 28rpx; }
.btn-send { width: 120rpx; height: 70rpx; line-height: 70rpx; font-size: 28rpx; background: #1296db; color: white; padding: 0; }