# .env 文件内容示例
# 数据库配置
DB_NAME=zhizuo
DB_PASSWORD=root_password
DB_PORT=3306

# Redis 配置
REDIS_PASSWORD=redis_password
REDIS_PORT=6379

# RabbitMQ 配置
RABBIT_USER=guest
RABBIT_PASSWORD=guest
RABBIT_MQ_PORT=5672
RABBIT_UI_PORT=15672

# AI 服务配置 (Google Gemini API Key)
# 如果没有 Key，AI 聊天功能可能无法使用，但其他功能正常
GEMINI_API_KEY=your_gemini_api_key_here