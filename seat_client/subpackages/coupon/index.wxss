/* subpackages/coupon/index.wxss */
page {
    background-color: #f5f5f5;
    height: 100%;
}

.container {
    display: flex;
    flex-direction: column;
    height: 100vh;
}

/* Tabs */
.tabs {
    display: flex;
    background: #fff;
    padding: 0 32rpx;
    position: sticky;
    top: 0;
    z-index: 10;
    box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.tab-item {
    flex: 1;
    text-align: center;
    padding: 24rpx 0;
    font-size: 28rpx;
    color: #666;
    position: relative;
}

.tab-item.active {
    color: #0022AB; /* 瑞幸蓝 */
    font-weight: bold;
}

.tab-item.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 40rpx;
    height: 4rpx;
    background: #0022AB;
    border-radius: 2rpx;
}

/* Scroll Content */
.content-scroll {
    flex: 1;
    padding: 24rpx;
    box-sizing: border-box;
}

.coupon-list {
    padding-bottom: 40rpx;
}

.empty-tip {
    text-align: center;
    color: #999;
    font-size: 26rpx;
    margin-top: 100rpx;
}

/* Coupon Card */
.coupon-card {
    display: flex;
    background: #fff;
    border-radius: 12rpx;
    margin-bottom: 24rpx;
    overflow: hidden;
    box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
    position: relative;
}

/* 左侧金额区 */
.card-left {
    width: 200rpx;
    background: #EBF2FF; /* 浅蓝背景 */
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    color: #0022AB;
    padding: 20rpx;
}

.amount-wrapper {
    display: flex;
    align-items: baseline;
}

.symbol {
    font-size: 28rpx;
    font-weight: bold;
}

.amount {
    font-size: 60rpx;
    font-weight: bold;
    line-height: 1;
}

.condition {
    font-size: 22rpx;
    margin-top: 10rpx;
    opacity: 0.8;
}

/* 右侧信息区 */
.card-right {
    flex: 1;
    padding: 24rpx;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.info {
    flex: 1;
    margin-right: 20rpx;
}

.title {
    font-size: 30rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 12rpx;
}

.date, .stock {
    font-size: 22rpx;
    color: #999;
}

/* 按钮样式 */
.btn {
    font-size: 24rpx;
    padding: 10rpx 24rpx;
    border-radius: 30rpx;
    line-height: 1.5;
    margin: 0;
}

.use-btn {
    background: #fff;
    color: #0022AB;
    border: 1px solid #0022AB;
}

.receive-btn {
    background: #0022AB;
    color: #fff;
    border: 1px solid #0022AB;
}

.receive-btn.disabled {
    background: #ccc;
    border-color: #ccc;
    color: #fff;
}

.status-text {
    font-size: 26rpx;
    color: #999;
}