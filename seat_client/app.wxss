/* seat_client/app.wxss */
page {
    /* 现代字体栈 */
    font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;

    /* 品牌色系优化 */
    --primary-color: #0022AB;       /* 瑞幸深蓝 */
    --primary-gradient: linear-gradient(135deg, #0022AB 0%, #2b4cbf 100%);
    --secondary-color: #d93025;     /* 瑞幸红（价格/警告） */
    --bg-color: #f7f8fa;            /* 浅灰背景，比纯白更护眼 */

    /* 质感变量 */
    --card-radius: 24rpx;
    --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
    --shadow-md: 0 8rpx 24rpx rgba(0, 34, 171, 0.08); /* 带一点品牌色的阴影 */
    --shadow-float: 0 16rpx 48rpx rgba(0, 34, 171, 0.12);
}

/* 全局卡片基础样式 */
.card-base {
    background: #ffffff;
    border-radius: var(--card-radius);
    box-shadow: var(--shadow-sm);
}

/* 点击反馈：缩小效果 */
.hover-scale:active {
    transform: scale(0.96);
    opacity: 0.9;
    transition: all 0.1s ease;
}

/* 全局空状态 */
.empty-state-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: 15vh;
    opacity: 0;
    animation: fadeIn 0.6s cubic-bezier(0.25, 0.8, 0.25, 1) forwards;
}

.empty-img {
    width: 280rpx;
    height: 280rpx;
    margin-bottom: 40rpx;
    filter: grayscale(20%) opacity(0.8); /* 图片微调 */
}

.empty-text {
    font-size: 30rpx;
    color: #999;
    font-weight: 500;
}

@keyframes fadeIn {
    to { opacity: 1; transform: translateY(0); }
    from { opacity: 0; transform: translateY(20rpx); }
}