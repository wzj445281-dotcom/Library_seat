page {
    background-color: #f5f5f5;
    padding-bottom: 120rpx;
}

.container {
    padding: 20rpx;
}

.section {
    background: #fff;
    border-radius: 16rpx;
    padding: 30rpx;
    margin-bottom: 20rpx;
}

/* 配送方式 */
.delivery-type {
    display: flex;
    padding: 10rpx;
}
.type-item {
    flex: 1;
    text-align: center;
    padding: 20rpx 0;
    border-radius: 12rpx;
    font-size: 30rpx;
    color: #666;
    border: 2rpx solid transparent;
}
.type-item.active {
    background: #eef2ff;
    color: #0022AB;
    border-color: #0022AB;
    font-weight: bold;
}

/* 地址 */
.address-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.addr-detail {
    font-size: 34rpx;
    font-weight: bold;
    color: #333;
}
.addr-user {
    font-size: 26rpx;
    color: #999;
    margin-top: 10rpx;
}
.phone {
    margin-left: 20rpx;
}
.addr-empty {
    width: 100%;
    display: flex;
    justify-content: space-between;
    color: #333;
    font-size: 30rpx;
}

/* 商品列表 */
.section-title {
    font-size: 30rpx;
    font-weight: bold;
    margin-bottom: 20rpx;
    border-bottom: 1rpx solid #eee;
    padding-bottom: 20rpx;
}
.product-item {
    display: flex;
    margin-bottom: 30rpx;
}
.product-item:last-child {
    margin-bottom: 0;
}
.thumb {
    width: 120rpx;
    height: 120rpx;
    border-radius: 12rpx;
    background: #f8f8f8;
    margin-right: 20rpx;
}
.info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}
.name {
    font-size: 28rpx;
    color: #333;
    font-weight: 500;
}
.spec {
    font-size: 24rpx;
    color: #999;
}
.price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.price {
    font-size: 32rpx;
    color: #333;
    font-weight: bold;
}

/* ✅ 步进器样式 */
.stepper {
    display: flex;
    align-items: center;
}
.step-btn {
    width: 48rpx;
    height: 48rpx;
    border-radius: 50%;
    text-align: center;
    line-height: 44rpx; /* 微调垂直居中 */
    font-size: 32rpx;
    font-weight: bold;
}
.minus {
    border: 2rpx solid #ddd;
    color: #666;
    background: #fff;
}
.plus {
    background: #0022AB;
    color: #fff;
    border: 2rpx solid #0022AB;
}
.step-num {
    width: 60rpx;
    text-align: center;
    font-size: 28rpx;
    color: #333;
}

/* 备注 */
.remark-input {
    margin-top: 20rpx;
    font-size: 28rpx;
}

/* 底部栏 */
.footer-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 100rpx;
    background: #fff;
    display: flex;
    align-items: center;
    padding: 0 30rpx;
    box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
    z-index: 100;
    padding-bottom: env(safe-area-inset-bottom);
}
.total-box {
    flex: 1;
    font-size: 28rpx;
}
.total-box .price {
    font-size: 40rpx;
    color: #0022AB;
    font-weight: bold;
    margin-left: 10rpx;
}
.pay-btn {
    background: #0022AB;
    color: #fff;
    font-size: 30rpx;
    border-radius: 40rpx;
    padding: 0 60rpx;
    height: 80rpx;
    line-height: 80rpx;
    margin: 0;
}