.container {
    min-height: 100vh;
    background-color: #f7f7f7;
    padding: 20rpx;
    padding-bottom: 120rpx; /* 底部留白 */
}

/* --- 用餐方式 --- */
.dining-type-card {
    background: #fff;
    border-radius: 16rpx;
    padding: 30rpx;
    margin-bottom: 20rpx;
}

/* 用餐方式切换优化：拟物浮起效果 */
.type-switch {
    display: flex;
    background: #f0f0f0; /* 更深的底色 */
    border-radius: 44rpx;
    padding: 6rpx;
    margin-bottom: 30rpx;
    box-shadow: inset 0 2rpx 6rpx rgba(0,0,0,0.05); /* 内阴影增加凹陷感 */
}

.switch-item {
    flex: 1;
    text-align: center;
    height: 76rpx;
    line-height: 76rpx;
    border-radius: 36rpx;
    font-size: 28rpx;
    color: #666;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.switch-item.active {
    background: #fff;
    color: #0022AB; /* 瑞幸蓝 */
    font-weight: bold;
    box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.1); /* 选中浮起 */
    transform: scale(1.02); /* 微放大 */
}

/* 地址栏/门店栏优化 */
.address-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 30rpx;
    padding-top: 20rpx;
    border-top: 1rpx dashed #eee; /* 改为虚线更有票据感 */
}

.address-info .store-name {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 10rpx;
}

.address-info .store-address {
    font-size: 24rpx;
    color: #999;
}
.text-gray { color: #ccc; }

/* --- 订单明细 --- */
.order-detail-card {
    background: #fff;
    border-radius: 16rpx;
    padding: 30rpx;
    box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.card-title {
    font-size: 30rpx;
    font-weight: bold;
    margin-bottom: 30rpx;
    border-bottom: 1rpx solid #f9f9f9;
    padding-bottom: 20rpx;
}

.cart-item {
    display: flex;
    margin-bottom: 30rpx;
}

.item-img {
    width: 100rpx;
    height: 100rpx;
    border-radius: 8rpx;
    background: #eee;
    margin-right: 20rpx;
}

.item-info {
    flex: 1;
}

.item-name { font-size: 28rpx; color: #333; margin-bottom: 8rpx; }
.item-spec { font-size: 22rpx; color: #999; }

.item-right { text-align: right; }
.item-count { font-size: 24rpx; color: #999; margin-bottom: 8rpx; }
.item-price { font-size: 28rpx; font-weight: bold; }

.remark-row {
    display: flex;
    align-items: center;
    padding: 20rpx 0;
    border-top: 1rpx solid #f9f9f9;
    border-bottom: 1rpx solid #f9f9f9;
    font-size: 28rpx;
}

.remark-input {
    flex: 1;
    margin-left: 20rpx;
    text-align: right;
    color: #333;
}

/* --- 优惠券选择 --- */
.coupon-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 0;
    border-top: 1rpx solid #f9f9f9;
    border-bottom: 1rpx solid #f9f9f9;
    font-size: 28rpx;
    margin-top: 20rpx;
}

.coupon-select {
    display: flex;
    align-items: center;
}

/* 优惠券选择行 */
.coupon-selected {
    background: #fff0f0;
    color: #d93025;
    padding: 4rpx 12rpx;
    border-radius: 8rpx;
    font-size: 24rpx;
    border: 1rpx solid rgba(217, 48, 37, 0.2);
    margin-right: 10rpx;
    font-weight: bold;
}

.coupon-placeholder {
    color: #999;
    margin-right: 10rpx;
}

.arrow {
    color: #ccc;
    font-size: 24rpx;
}

/* --- 价格明细 --- */
.price-detail {
    margin-top: 20rpx;
    padding-top: 20rpx;
    border-top: 1rpx solid #f9f9f9;
}

.price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10rpx 0;
    font-size: 26rpx;
    color: #666;
}

.price-row.total {
    margin-top: 10rpx;
    padding-top: 20rpx;
    border-top: 1rpx solid #f9f9f9;
    font-size: 30rpx;
    font-weight: bold;
    color: #333;
}

.discount {
    color: #d93025;
    font-weight: bold;
}

.final-price {
    color: #d93025;
    font-size: 36rpx;
}

/* --- 优惠券选择弹窗 --- */
.coupon-picker-mask {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    display: flex;
    align-items: flex-end;
}

.coupon-picker {
    width: 100%;
    max-height: 70vh;
    background: #fff;
    border-radius: 30rpx 30rpx 0 0;
    display: flex;
    flex-direction: column;
}

.picker-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx;
    border-bottom: 1rpx solid #f9f9f9;
    font-size: 32rpx;
    font-weight: bold;
}

.picker-header .close {
    font-size: 50rpx;
    color: #999;
    line-height: 1;
}

.picker-content {
    flex: 1;
    max-height: 60vh;
    padding: 20rpx;
}

.coupon-option {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx;
    margin-bottom: 20rpx;
    background: linear-gradient(135deg, #0022AB 0%, #0044CC 100%);
    border-radius: 16rpx;
    color: #fff;
}

.coupon-info {
    flex: 1;
}

.coupon-title {
    display: block;
    font-size: 32rpx;
    font-weight: bold;
    margin-bottom: 10rpx;
}

.coupon-desc {
    display: block;
    font-size: 24rpx;
    opacity: 0.9;
}

.coupon-amount {
    font-size: 48rpx;
    font-weight: bold;
}

.empty-coupon {
    text-align: center;
    padding: 100rpx 0;
    color: #999;
    font-size: 28rpx;
}

.total-row {
    margin-top: 30rpx;
    text-align: right;
    font-size: 26rpx;
}

.total-row .total-price {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
    margin-left: 10rpx;
}

/* --- 底部支付栏 --- */
.footer-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100rpx;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px); /* iOS支持 */
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 30rpx;
    box-sizing: border-box;
    box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
    padding-bottom: env(safe-area-inset-bottom);
    z-index: 999;
}

.price-section { display: flex; align-items: baseline; }
.price-section .label { font-size: 24rpx; margin-right: 10rpx; }
.price-section .price { 
    font-family: 'DIN Alternate', sans-serif;
    font-size: 44rpx; /* 加大 */
    font-weight: bold; 
    color: #d93025; 
}

.pay-btn {
    width: 240rpx;
    height: 80rpx;
    line-height: 80rpx;
    text-align: center;
    background: linear-gradient(135deg, #0022AB 0%, #0033CC 100%);
    color: #fff;
    font-size: 32rpx;
    font-weight: bold;
    border-radius: 40rpx;
    box-shadow: 0 6rpx 16rpx rgba(0, 34, 171, 0.3);
}
.pay-btn:active { 
    opacity: 0.9; 
    transform: scale(0.98);
}