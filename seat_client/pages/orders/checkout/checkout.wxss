.container {
    min-height: 100vh;
    background-color: #f7f7f7;
    padding: 20rpx;
    padding-bottom: 120rpx; /* 底部留白 */
}

/* --- 用餐方式 --- */
.dining-type-card {
    background: #fff;
    border-radius: 16rpx;
    padding: 30rpx;
    margin-bottom: 20rpx;
}

.type-switch {
    display: flex;
    background: #f2f2f2;
    border-radius: 40rpx;
    padding: 4rpx;
    margin-bottom: 30rpx;
}

.switch-item {
    flex: 1;
    text-align: center;
    height: 70rpx;
    line-height: 70rpx;
    border-radius: 36rpx;
    font-size: 28rpx;
    color: #666;
}

.switch-item.active {
    background: #fff;
    color: #0022AB; /* 瑞幸蓝 */
    font-weight: bold;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.address-info .store-name {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 10rpx;
}

.address-info .store-address {
    font-size: 24rpx;
    color: #999;
}
.text-gray { color: #ccc; }

/* --- 订单明细 --- */
.order-detail-card {
    background: #fff;
    border-radius: 16rpx;
    padding: 30rpx;
}

.card-title {
    font-size: 30rpx;
    font-weight: bold;
    margin-bottom: 30rpx;
    border-bottom: 1rpx solid #f9f9f9;
    padding-bottom: 20rpx;
}

.cart-item {
    display: flex;
    margin-bottom: 30rpx;
}

.item-img {
    width: 100rpx;
    height: 100rpx;
    border-radius: 8rpx;
    background: #eee;
    margin-right: 20rpx;
}

.item-info {
    flex: 1;
}

.item-name { font-size: 28rpx; color: #333; margin-bottom: 8rpx; }
.item-spec { font-size: 22rpx; color: #999; }

.item-right { text-align: right; }
.item-count { font-size: 24rpx; color: #999; margin-bottom: 8rpx; }
.item-price { font-size: 28rpx; font-weight: bold; }

.remark-row {
    display: flex;
    align-items: center;
    padding: 20rpx 0;
    border-top: 1rpx solid #f9f9f9;
    border-bottom: 1rpx solid #f9f9f9;
    font-size: 28rpx;
}

.remark-input {
    flex: 1;
    margin-left: 20rpx;
    text-align: right;
    color: #333;
}

/* --- 优惠券选择 --- */
.coupon-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 0;
    border-top: 1rpx solid #f9f9f9;
    border-bottom: 1rpx solid #f9f9f9;
    font-size: 28rpx;
    margin-top: 20rpx;
}

.coupon-select {
    display: flex;
    align-items: center;
}

.coupon-selected {
    color: #0022AB;
    font-weight: bold;
    margin-right: 10rpx;
}

.coupon-placeholder {
    color: #999;
    margin-right: 10rpx;
}

.arrow {
    color: #ccc;
    font-size: 24rpx;
}

/* --- 价格明细 --- */
.price-detail {
    margin-top: 20rpx;
    padding-top: 20rpx;
    border-top: 1rpx solid #f9f9f9;
}

.price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10rpx 0;
    font-size: 26rpx;
    color: #666;
}

.price-row.total {
    margin-top: 10rpx;
    padding-top: 20rpx;
    border-top: 1rpx solid #f9f9f9;
    font-size: 30rpx;
    font-weight: bold;
    color: #333;
}

.discount {
    color: #d93025;
    font-weight: bold;
}

.final-price {
    color: #d93025;
    font-size: 36rpx;
}

/* --- 优惠券选择弹窗 --- */
.coupon-picker-mask {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    display: flex;
    align-items: flex-end;
}

.coupon-picker {
    width: 100%;
    max-height: 70vh;
    background: #fff;
    border-radius: 30rpx 30rpx 0 0;
    display: flex;
    flex-direction: column;
}

.picker-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx;
    border-bottom: 1rpx solid #f9f9f9;
    font-size: 32rpx;
    font-weight: bold;
}

.picker-header .close {
    font-size: 50rpx;
    color: #999;
    line-height: 1;
}

.picker-content {
    flex: 1;
    max-height: 60vh;
    padding: 20rpx;
}

.coupon-option {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx;
    margin-bottom: 20rpx;
    background: linear-gradient(135deg, #0022AB 0%, #0044CC 100%);
    border-radius: 16rpx;
    color: #fff;
}

.coupon-info {
    flex: 1;
}

.coupon-title {
    display: block;
    font-size: 32rpx;
    font-weight: bold;
    margin-bottom: 10rpx;
}

.coupon-desc {
    display: block;
    font-size: 24rpx;
    opacity: 0.9;
}

.coupon-amount {
    font-size: 48rpx;
    font-weight: bold;
}

.empty-coupon {
    text-align: center;
    padding: 100rpx 0;
    color: #999;
    font-size: 28rpx;
}

.total-row {
    margin-top: 30rpx;
    text-align: right;
    font-size: 26rpx;
}

.total-row .total-price {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
    margin-left: 10rpx;
}

/* --- 底部支付栏 --- */
.footer-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100rpx;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 30rpx;
    box-sizing: border-box;
    box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
    padding-bottom: env(safe-area-inset-bottom);
    z-index: 999;
}

.price-section { display: flex; align-items: baseline; }
.price-section .label { font-size: 24rpx; margin-right: 10rpx; }
.price-section .price { font-size: 40rpx; font-weight: bold; color: #d93025; }

.pay-btn {
    width: 240rpx;
    height: 80rpx;
    line-height: 80rpx;
    text-align: center;
    background: #0022AB;
    color: #fff;
    font-size: 30rpx;
    font-weight: bold;
    border-radius: 40rpx;
}
.pay-btn:active { opacity: 0.9; }