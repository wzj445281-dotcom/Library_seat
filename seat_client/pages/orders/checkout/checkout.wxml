<view class="container">
    <!-- 用餐方式选择 -->
    <view class="dining-type-card">
        <view class="type-switch">
            <view class="switch-item {{diningType === 'self' ? 'active' : ''}}" bindtap="switchDiningType" data-type="self">
                到店自取
            </view>
            <view class="switch-item {{diningType === 'delivery' ? 'active' : ''}}" bindtap="switchDiningType" data-type="delivery">
                外卖配送
            </view>
        </view>

        <!-- 门店信息/地址信息 -->
        <view class="address-info" wx:if="{{diningType === 'self'}}">
            <view class="store-name">{{storeInfo.name}}</view>
            <view class="store-address">{{storeInfo.address}}</view>
        </view>
        <view class="address-info" wx:else>
            <view class="store-name">请选择收货地址</view>
            <view class="store-address text-gray">暂未支持外卖地址选择，默认配送至当前定位</view>
        </view>
    </view>

    <!-- 订单明细 -->
    <view class="order-detail-card">
        <view class="card-title">订单详情</view>
        <block wx:for="{{cartItems}}" wx:key="productId">
            <view class="cart-item">
                <image class="item-img" src="{{item.image}}" mode="aspectFill"></image>
                <view class="item-info">
                    <view class="item-name">{{item.name}}</view>
                    <view class="item-spec">{{item.spec}}</view>
                </view>
                <view class="item-right">
                    <view class="item-count">x{{item.count}}</view>
                    <view class="item-price">¥{{item.price}}</view>
                </view>
            </view>
        </block>

        <!-- 备注输入 -->
        <view class="remark-row">
            <text>备注</text>
            <input class="remark-input" placeholder="口味、包装等要求" value="{{remark}}" bindinput="onRemarkInput" />
        </view>

        <!-- 小计 -->
        <view class="total-row">
            <text>共{{totalCount}}件商品，小计</text>
            <text class="total-price">¥{{totalPrice}}</text>
        </view>
    </view>

    <!-- 底部支付栏 -->
    <view class="footer-bar">
        <view class="price-section">
            <text class="label">合计</text>
            <text class="price">¥{{totalPrice}}</text>
        </view>
        <view class="pay-btn" bindtap="submitOrder">去支付</view>
    </view>
</view>