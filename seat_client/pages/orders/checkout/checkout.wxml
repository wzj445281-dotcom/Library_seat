<view class="container">
    <view class="section delivery-type">
        <view class="type-item {{deliveryType===1 ? 'active' : ''}}" bindtap="selectDelivery" data-type="1">
            <text>配送到座</text>
        </view>
        <view class="type-item {{deliveryType===2 ? 'active' : ''}}" bindtap="selectDelivery" data-type="2">
            <text>门店自取</text>
        </view>
    </view>

    <view class="section address-card" wx:if="{{deliveryType === 1}}" bindtap="chooseAddress">
        <view class="addr-info" wx:if="{{address}}">
            <view class="addr-top">
                <text class="addr-detail">{{address.seatInfo || address.detail}}</text>
            </view>
            <view class="addr-user">
                <text>{{address.contact}}</text>
                <text class="phone">{{address.phone}}</text>
            </view>
        </view>
        <view class="addr-empty" wx:else>
            <text>请选择收货地址/座位号</text>
            <text class="arrow">></text>
        </view>
    </view>

    <view class="section product-list">
        <view class="section-title">订单详情</view>
        <view class="product-item" wx:for="{{cartList}}" wx:key="id">
            <image class="thumb" src="{{item.image || item.pic}}" mode="aspectFill"></image>
            <view class="info">
                <view class="name">{{item.name}}</view>
                <view class="spec">{{item.spec || '标准'}}</view>
                <view class="price-row">
                    <text class="price">¥{{item.price}}</text>

                    <view class="stepper">
                        <view class="step-btn minus" catchtap="reduceItem" data-index="{{index}}">-</view>
                        <view class="step-num">{{item.quantity}}</view>
                        <view class="step-btn plus" catchtap="addItem" data-index="{{index}}">+</view>
                    </view>

                </view>
            </view>
        </view>
    </view>

    <view class="section remark-section">
        <text>备注</text>
        <input class="remark-input" placeholder="口味、包装等要求" bindinput="onRemarkInput" />
    </view>

    <view class="section coupon-section" bindtap="selectCoupon">
        <view class="coupon-left">
            <text>优惠券</text>
            <text class="coupon-desc" wx:if="{{selectedCoupon}}">{{selectedCoupon.title}}</text>
            <text class="coupon-desc" wx:else>{{availableCoupons.length > 0 ? availableCoupons.length + '张可用' : '暂无可用优惠券'}}</text>
        </view>
        <view class="coupon-right">
            <text class="coupon-value" wx:if="{{selectedCoupon}}">-¥{{selectedCoupon.amount}}</text>
            <text class="arrow">></text>
        </view>
    </view>

    <view class="footer-bar">
        <view class="total-box">
            <text>合计</text>
            <text class="price">¥{{finalPrice}}</text>
        </view>
        <button class="pay-btn" bindtap="submitOrder" disabled="{{submitting}}">
            {{submitting ? '提交中...' : '去支付'}}
        </button>
    </view>
</view>