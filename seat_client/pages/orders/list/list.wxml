<view class="container">
    <!-- 顶部 Tab -->
    <view class="tabs">
        <view
                class="tab-item {{activeTab === index ? 'active' : ''}}"
                wx:for="{{tabs}}"
                wx:key="index"
                bindtap="onTabChange"
                data-index="{{index}}"
        >
            {{item}}
        </view>
    </view>

    <!-- 订单列表 -->
    <scroll-view scroll-y class="order-list">
        <view class="empty" wx:if="{{!loading && orders.length === 0}}">
            <image src="/assets/images/book-default.png" mode="aspectFit"></image>
            <text>暂无订单</text>
        </view>

        <view class="order-card" wx:for="{{orders}}" wx:key="id">
            <!-- 卡片头：单号 + 状态 -->
            <view class="card-header">
                <text class="time">{{item.createTime}}</text>
                <text class="status {{item.status}}">{{item.statusText}}</text>
            </view>

            <!-- 卡片体：商品列表 -->
            <view class="card-body">
                <view class="product-item" wx:for="{{item.products}}" wx:for-item="prod" wx:key="id">
                    <view class="prod-name">{{prod.productName}}</view>
                    <view class="prod-info">
                        <text>x{{prod.quantity}}</text>
                        <text class="price">¥{{prod.price}}</text>
                    </view>
                </view>
            </view>

            <!-- 取餐码高亮展示 (如果是待取餐状态) -->
            <view class="pickup-code-box" wx:if="{{item.status === 'READY' && item.pickupCode}}">
                <text>取餐码：</text>
                <text class="code">{{item.pickupCode}}</text>
            </view>

            <!-- 卡片底：总计 + 操作按钮 -->
            <view class="card-footer">
                <view class="total">
                    共 {{item.totalCount}} 件，实付 <text class="amount">¥{{item.totalAmount}}</text>
                </view>
                <view class="actions">
                    <!-- 只有 未付款 或 制作中(根据业务宽松度) 可以取消 -->
                    <button
                            wx:if="{{item.status === 'PENDING' || item.status === 'PAID'}}"
                            class="btn btn-outline"
                            size="mini"
                            bindtap="handleCancel"
                            data-no="{{item.orderNo}}"
                    >取消</button>

                    <button
                            wx:if="{{item.status === 'PENDING'}}"
                            class="btn btn-primary"
                            size="mini"
                            bindtap="handlePay"
                            data-no="{{item.orderNo}}"
                    >去支付</button>
                </view>
            </view>
        </view>

        <view class="loading" wx:if="{{loading}}">加载中...</view>
    </scroll-view>
</view>