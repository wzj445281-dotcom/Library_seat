/* 全局容器，使用标志性的浅灰背景 */
.container {
  height: 100vh;
  background-color: #f7f7f7;
  display: flex;
  flex-direction: column;
}

/* --- 顶部 Tabs --- */
.tabs {
  background: #fff;
  display: flex;
  height: 88rpx;
  align-items: center;
  justify-content: space-around; /* 分散对齐 */
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 1rpx 0 rgba(0, 0, 0, 0.05); /* 极细分割线 */
}

.tab-item {
  flex: none;
  padding: 0 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  position: relative;
  height: 100%;
  line-height: 88rpx;
  font-weight: 400;
  transition: all 0.3s;
}

.tab-item.active {
  color: #0022AB; /* 瑞幸蓝 */
  font-weight: 600;
  font-size: 30rpx;
}

/* 激活状态下的小蓝条 */
.tab-line {
  position: absolute;
  bottom: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #0022AB;
  border-radius: 4rpx;
}

/* --- 列表区域 --- */
.order-list {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

/* --- 订单卡片核心样式 --- */
.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  /* 更柔和、更有层次的阴影 */
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
  position: relative;
  overflow: hidden;
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f9f9f9;
}

.store-info {
  display: flex;
  flex-direction: column;
}

.store-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
}

/* 店铺名后的小箭头 */
.store-name::after {
  content: " ";
  display: inline-block;
  height: 12rpx;
  width: 12rpx;
  border-width: 2rpx 2rpx 0 0;
  border-color: #999;
  border-style: solid;
  transform: rotate(45deg);
  margin-left: 8rpx;
  margin-top: 2rpx;
}

/* 瑞幸风格的标签：实心蓝底 */
.order-tag {
  font-size: 20rpx;
  color: #fff;
  background-color: #0022AB;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  line-height: 1;
  align-self: flex-start;
}

.order-status {
  font-size: 28rpx;
  font-weight: 500;
}

/* 状态颜色定义 */
.text-luckin { color: #0022AB; }
.text-orange { color: #FF8800; }
.text-gray { color: #999; }

/* --- 核心：取餐码区域 (Ready状态) --- */
/* 增加淡灰色背景，使其像一张票据 */
.pickup-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #fcfcfc; 
  margin: 24rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid #f5f5f5;
}

.pickup-info {
  display: flex;
  flex-direction: column;
}

.pickup-info .label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.pickup-info .code {
  font-size: 60rpx; /* 巨大字号 */
  color: #0022AB; /* 瑞幸蓝 */
  font-weight: bold;
  font-family: 'DIN Alternate', 'Arial', sans-serif; /* 尝试使用数字字体 */
  line-height: 1;
  letter-spacing: 2rpx;
}

.qr-placeholder {
  width: 70rpx;
  height: 70rpx;
  /* background: #f5f5f5; */
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qr-icon {
  width: 60rpx;
  height: 60rpx;
  opacity: 0.8;
}

/* 普通商品区域 */
.product-section {
  padding: 24rpx 0;
}

.product-desc {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.5;
  /* 限制行数 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 信息行 (时间、价格) */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.price-info {
  display: flex;
  align-items: baseline;
}

.price-info .count {
  margin-right: 12rpx;
  font-size: 24rpx;
}

.price-info .price {
  font-size: 34rpx;
  color: #333;
  font-weight: bold;
  font-family: 'DIN Alternate', sans-serif;
}

/* 底部按钮栏 */
.card-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f9f9f9;
}

/* 胶囊按钮 */
.btn-outline {
  background: #fff;
  border: 1rpx solid #0022AB;
  color: #0022AB;
  font-size: 26rpx;
  padding: 12rpx 36rpx;
  border-radius: 34rpx; /* 完整的胶囊形状 */
  line-height: 1.4;
  font-weight: 500;
  margin-left: 16rpx;
}

.btn-outline::after {
  border: none;
}

/* 取消按钮特殊样式 */
.btn-cancel {
  border-color: #ff4757;
  color: #ff4757;
}

/* 点击态 */
.btn-outline-hover {
  background-color: #f0f5ff;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-state image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 20rpx;
  opacity: 0.8;
}

.empty-state text {
  color: #999;
  font-size: 28rpx;
  margin-bottom: 48rpx;
}

.btn-go-menu {
  background: #0022AB;
  color: #fff;
  font-size: 30rpx;
  padding: 20rpx 80rpx;
  border-radius: 44rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 16rpx rgba(0, 34, 171, 0.2); /* 按钮投影 */
}

.loading-more, .no-more {
  text-align: center;
  padding: 30rpx;
  color: #ccc;
  font-size: 22rpx;
}