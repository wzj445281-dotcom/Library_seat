.container {
  height: 100vh;
  background-color: #f7f7f7;
  display: flex;
  flex-direction: column;
}

/* --- Tab 样式 --- */
.tabs {
  background: #fff;
  height: 96rpx; /* 加高 */
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03); /* 轻微投影 */
  border-bottom: none; /* 去掉硬边框 */
  flex-shrink: 0;
  z-index: 10;
}

.tab-item {
  font-size: 30rpx;
  color: #666;
  height: 100%;
  display: flex;
  align-items: center;
  position: relative;
  padding: 0 20rpx;
  transition: all 0.3s;
}

.tab-item.active {
  color: #0022AB; /* 瑞幸蓝 */
  font-weight: 800;
  font-size: 32rpx; /* 选中放大 */
}

.tab-item .line {
  position: absolute;
  bottom: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx; /* 优化下划线：改为圆润的短线 */
  height: 6rpx;
  background: #0022AB;
  border-radius: 6rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 34, 171, 0.3);
}

/* --- 列表区域 --- */
.list-scroll {
  flex: 1;
  padding: 20rpx;
  box-sizing: border-box;
}

.order-list {
  padding: 20rpx;
}

/* --- 订单卡片 --- */
.order-card {
  background: #fff;
  border-radius: 24rpx; /* 更大的圆角 */
  padding: 32rpx;
  margin-bottom: 30rpx;
  /* 双层投影 */
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.02), 0 8rpx 20rpx rgba(0,0,0,0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f9f9f9;
  margin-bottom: 20rpx;
}

.shop-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

/* 状态标签化：不仅仅是文字颜色 */
.status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.status.MAKING { 
  background: #e6f3ff; 
  color: #0022AB; 
}

.status.WAIT_PICKUP { 
  background: #fff7e6; 
  color: #FF9900; 
}

.status.CANCELLED { 
  background: #f5f5f5; 
  color: #999; 
}

.card-content {
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.order-desc {
  font-size: 28rpx;
  color: #333;
}

/* 价格字体优化 */
.order-price {
  font-family: 'DIN Alternate', sans-serif;
  font-size: 34rpx;
  color: #333;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.card-footer {
  display: flex;
  justify-content: flex-end;
}

.btn-group {
  display: flex;
  gap: 20rpx;
}

/* 按钮组优化 */
.action-btn {
  padding: 12rpx 36rpx;
  font-size: 26rpx;
  border-radius: 36rpx;
  font-weight: 600;
  transition: opacity 0.2s;
}

.action-btn.outline {
  border: 2rpx solid #e0e0e0; /* 边框加粗一点 */
  color: #666;
  background: transparent;
}

.action-btn.primary {
  background: #0022AB;
  color: #fff;
  border: 2rpx solid #0022AB;
  box-shadow: 0 4rpx 10rpx rgba(0, 34, 171, 0.2);
}

.action-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* --- 空状态 --- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 150rpx;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.go-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #0022AB;
  color: #fff;
  font-size: 30rpx;
  border-radius: 40rpx;
}