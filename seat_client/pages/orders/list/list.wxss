.container {
    background: #f5f5f5;
    height: 100vh;
    display: flex;
    flex-direction: column;
}

/* Tabs */
.tabs {
    display: flex;
    background: #fff;
    padding: 0 20rpx;
    position: sticky;
    top: 0;
    z-index: 10;
}
.tab-item {
    flex: 1;
    text-align: center;
    padding: 24rpx 0;
    font-size: 28rpx;
    color: #666;
    position: relative;
}
.tab-item.active {
    color: #e64340; /* 瑞幸红/书局红 */
    font-weight: bold;
}
.tab-item.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 40rpx;
    height: 4rpx;
    background: #e64340;
}

/* List */
.order-list {
    flex: 1;
    padding: 20rpx;
    box-sizing: border-box;
}

.order-card {
    background: #fff;
    border-radius: 16rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

/* Header */
.card-header {
    display: flex;
    justify-content: space-between;
    font-size: 24rpx;
    border-bottom: 1rpx solid #eee;
    padding-bottom: 20rpx;
    margin-bottom: 20rpx;
}
.time { color: #999; }
.status { font-weight: bold; }
.status.PENDING { color: #ff9900; }
.status.PAID { color: #1aad19; } /* 制作中-绿色 */
.status.READY { color: #e64340; font-size: 28rpx; } /* 待取-红色醒目 */
.status.COMPLETED { color: #999; }
.status.CANCELLED { color: #ccc; }

/* Body */
.product-item {
    display: flex;
    justify-content: space-between;
    margin-bottom: 16rpx;
    font-size: 28rpx;
    color: #333;
}
.prod-info {
    color: #666;
    display: flex;
    gap: 20rpx;
}
.prod-info .price {
    color: #333;
    font-weight: bold;
}

/* Pickup Code */
.pickup-code-box {
    background: #fff0f0;
    padding: 16rpx;
    border-radius: 8rpx;
    text-align: center;
    margin: 20rpx 0;
    color: #e64340;
}
.pickup-code-box .code {
    font-size: 36rpx;
    font-weight: bold;
    margin-left: 10rpx;
}

/* Footer */
.card-footer {
    border-top: 1rpx solid #f5f5f5;
    padding-top: 20rpx;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.total {
    font-size: 24rpx;
    color: #666;
}
.total .amount {
    font-size: 32rpx;
    color: #333;
    font-weight: bold;
}
.actions .btn {
    margin-left: 16rpx;
    font-size: 24rpx;
}
.btn-outline {
    background: #fff;
    border: 1rpx solid #ddd;
    color: #666;
}
.btn-primary {
    background: #e64340;
    color: #fff;
    border: none;
}

/* Empty */
.empty {
    text-align: center;
    padding-top: 100rpx;
    color: #999;
}
.empty image {
    width: 200rpx;
    height: 200rpx;
    margin-bottom: 20rpx;
    filter: grayscale(100%);
}