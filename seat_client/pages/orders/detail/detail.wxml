<view class="container" wx:if="{{!loading}}">
    <view class="header-bg">
        <view class="status-title">{{order.statusText}}</view>
        <view class="status-desc" wx:if="{{order.status === 'PENDING'}}">请在15分钟内完成支付</view>
        <view class="status-desc" wx:elif="{{order.status === 'CANCELLED'}}">订单已取消，欢迎再次选购</view>
        <view class="status-desc" wx:else>感谢您对瑞幸的支持，期待再次光临</view>
    </view>

    <view class="content-wrapper">
        <view class="card pickup-card" wx:if="{{order.status === 'READY' || order.status === 'WAIT_PICKUP'}}">
            <view class="pickup-header">
                <text>取餐码</text>
            </view>
            <view class="pickup-content">
                <view class="pickup-code">{{order.pickupCode}}</view>
            </view>
            <view class="pickup-tip">请向店员出示取餐码取餐</view>
        </view>

        <view class="card step-card">
            <view class="steps-box">
                <view class="step-item {{item.active ? 'active' : ''}}" wx:for="{{steps}}" wx:key="index">
                    <view class="dot-wrapper">
                        <view class="dot"></view>
                        <view class="line" wx:if="{{index < steps.length - 1}}"></view>
                    </view>
                    <view class="text-wrapper">
                        <text class="step-title">{{item.text}}</text>
                        <text class="step-time">{{item.time}}</text>
                    </view>
                </view>
            </view>
        </view>

        <view class="card store-card">
            <view class="store-info">
                <view class="name">{{order.storeName}}</view>
                <view class="address">{{order.storeAddress}}</view>
            </view>
            <view class="store-actions">
                <image src="/assets/images/user.png" class="action-icon" bindtap="onCallStore" />
            </view>
        </view>

        <view class="card product-card">
            <view class="product-item" wx:for="{{order.items}}" wx:key="index">
                <image class="thumb" src="{{item.productImage}}" mode="aspectFill"></image>
                <view class="info">
                    <view class="name">{{item.productName}}</view>
                    <view class="spec">{{item.spec || '标准'}}</view>
                </view>
                <view class="price-box">
                    <view class="quantity">x{{item.quantity}}</view>
                    <view class="price">¥{{item.price}}</view>
                </view>
            </view>

            <view class="bill-row">
                <text>商品总价</text>
                <text>¥{{order.totalAmount}}</text>
            </view>
            <view class="bill-row discount">
                <text>优惠抵扣</text>
                <text>-¥{{order.discountAmount}}</text>
            </view>
            <view class="bill-total">
                <text>实付</text>
                <text class="real-price">¥{{order.realAmount}}</text>
            </view>
        </view>

        <view class="card info-card">
            <view class="info-row">
                <text class="label">下单时间</text>
                <text class="val">{{order.createTime}}</text>
            </view>
            <view class="info-row">
                <text class="label">订单编号</text>
                <text class="val">{{order.orderNo}}</text>
                <text class="copy-btn">复制</text>
            </view>
            <view class="info-row">
                <text class="label">备注信息</text>
                <text class="val">{{order.remark}}</text>
            </view>
        </view>

        <view style="height: 120rpx;"></view>
    </view>

    <view class="footer-bar">
        <block wx:if="{{order.status === 'PENDING' || order.status === 'PENDING_PAY'}}">
            <button class="footer-btn secondary" bindtap="onCancelOrder">取消订单</button>
            <button class="footer-btn primary" bindtap="onPay">立即支付</button>
        </block>

        <block wx:else>
            <button class="footer-btn outline" bindtap="onOrderAgain">再来一单</button>
        </block>
    </view>
</view>