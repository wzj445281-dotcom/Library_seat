/* 容器与背景 */
.container {
    background-color: #f5f5f5;
    min-height: 100vh;
    padding-bottom: 0;
}

.header-bg {
    background: linear-gradient(135deg, #0022AB 0%, #0044CC 100%);
    color: #fff;
    padding: 40rpx 32rpx 120rpx; /* 底部留白给卡片上移 */
}

.status-title {
    font-size: 40rpx;
    font-weight: bold;
    margin-bottom: 12rpx;
}

.status-desc {
    font-size: 26rpx;
    opacity: 0.9;
}

.content-wrapper {
    padding: 0 24rpx;
    margin-top: -80rpx; /* 卡片上移覆盖背景 */
}

/* 卡片通用样式 */
.card {
    background: #fff;
    border-radius: 16rpx;
    padding: 30rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 取餐码卡片 */
.pickup-card {
    text-align: center;
}
.pickup-header {
    font-size: 28rpx;
    color: #666;
    margin-bottom: 20rpx;
}
.pickup-code {
    font-size: 64rpx;
    font-weight: bold;
    color: #333;
    letter-spacing: 4rpx;
    margin-bottom: 20rpx;
}
.pickup-tip {
    font-size: 24rpx;
    color: #999;
}

/* 进度条 */
.steps-box {
    display: flex;
    justify-content: space-between;
}
.step-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
}
.dot-wrapper {
    position: relative;
    width: 100%;
    height: 40rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}
.dot {
    width: 16rpx;
    height: 16rpx;
    background: #ddd;
    border-radius: 50%;
    z-index: 2;
}
.active .dot {
    background: #0022AB;
    box-shadow: 0 0 0 6rpx rgba(0, 34, 171, 0.2);
}
.line {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 2rpx;
    background: #eee;
    z-index: 1;
    transform: translateY(-50%);
}
.active .line {
    background: #0022AB; /* 激活状态线颜色 */
}
/* 修复最后一个节点不需要线，但在WXML里已经判断了 */

.text-wrapper {
    margin-top: 10rpx;
    text-align: center;
}
.step-title {
    font-size: 24rpx;
    color: #999;
    display: block;
}
.active .step-title {
    color: #333;
    font-weight: 500;
}
.step-time {
    font-size: 20rpx;
    color: #ccc;
    display: block;
    margin-top: 4rpx;
}
.active .step-time {
    color: #666;
}

/* 门店信息 */
.store-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.store-info .name {
    font-size: 30rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 8rpx;
}
.store-info .address {
    font-size: 24rpx;
    color: #999;
}
.action-icon {
    width: 48rpx;
    height: 48rpx;
    padding: 10rpx;
}

/* 商品列表 */
.product-item {
    display: flex;
    margin-bottom: 30rpx;
}
.thumb {
    width: 110rpx;
    height: 110rpx;
    background: #f8f8f8;
    border-radius: 8rpx;
    margin-right: 20rpx;
}
.info {
    flex: 1;
}
.info .name {
    font-size: 28rpx;
    color: #333;
    margin-bottom: 8rpx;
}
.info .spec {
    font-size: 22rpx;
    color: #999;
}
.price-box {
    text-align: right;
}
.price-box .quantity {
    font-size: 24rpx;
    color: #999;
    margin-bottom: 8rpx;
}
.price-box .price {
    font-size: 28rpx;
    color: #333;
    font-weight: 500;
}

.bill-row {
    display: flex;
    justify-content: space-between;
    font-size: 26rpx;
    color: #666;
    margin-bottom: 16rpx;
}
.discount {
    color: #ff5000;
}
.bill-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1rpx solid #eee;
    padding-top: 24rpx;
    margin-top: 20rpx;
    font-size: 28rpx;
    color: #333;
}
.real-price {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
}

/* 订单信息 */
.info-row {
    display: flex;
    margin-bottom: 16rpx;
    font-size: 24rpx;
}
.info-row:last-child {
    margin-bottom: 0;
}
.info-row .label {
    width: 140rpx;
    color: #999;
}
.info-row .val {
    flex: 1;
    color: #333;
}
.copy-btn {
    color: #0022AB;
    margin-left: 20rpx;
}

/* 底部栏 */
.footer-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #fff;
    padding: 20rpx 32rpx;
    padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
    box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
    display: flex;
    justify-content: flex-end;
    gap: 20rpx;
    z-index: 99;
}

.footer-btn {
    margin: 0;
    font-size: 28rpx;
    border-radius: 40rpx;
    padding: 0 40rpx;
    height: 72rpx;
    line-height: 72rpx;
    min-width: 160rpx;
    text-align: center;
}

.footer-btn.primary {
    background: #0022AB;
    color: #fff;
    box-shadow: 0 4rpx 10rpx rgba(0, 34, 171, 0.3);
}

.footer-btn.secondary {
    background: #f5f5f5;
    color: #666;
}

.footer-btn.outline {
    background: #fff;
    color: #0022AB;
    border: 2rpx solid #0022AB;
    line-height: 68rpx; /* 扣除边框 */
}

/* 点击态 */
.footer-btn:active {
    opacity: 0.8;
}