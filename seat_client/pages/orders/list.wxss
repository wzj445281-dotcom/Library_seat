page {
    background-color: #f5f5f5;
    height: 100%;
}

.container {
    display: flex;
    flex-direction: column;
    height: 100%;
}

.tabs {
    display: flex;
    background: #fff;
    height: 88rpx;
    line-height: 88rpx;
    position: sticky;
    top: 0;
    z-index: 10;
    box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.tab-item {
    flex: 1;
    text-align: center;
    font-size: 28rpx;
    color: #666;
    position: relative;
}

.tab-item.active {
    color: #0022AB;
    font-weight: bold;
}

.tab-item.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 40rpx;
    height: 4rpx;
    background: #0022AB;
    border-radius: 2rpx;
}

.order-list {
    flex: 1;
    padding: 24rpx;
    overflow-y: auto;
}

.order-item {
    background: #fff;
    border-radius: 16rpx;
    padding: 24rpx;
    margin-bottom: 24rpx;
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 20rpx;
    border-bottom: 1rpx solid #f5f5f5;
    margin-bottom: 20rpx;
}

.shop-name {
    font-size: 28rpx;
    font-weight: 500;
    color: #333;
}

.status {
    font-size: 26rpx;
}
.status.PENDING { color: #ff9900; }
.status.MAKING, .status.PAID { color: #0022AB; }
.status.READY, .status.WAIT_PICKUP { color: #0022AB; }
.status.COMPLETED { color: #999; }
.status.CANCELLED { color: #999; }

.content {
    display: flex;
    margin-bottom: 20rpx;
}

.thumb {
    width: 100rpx;
    height: 100rpx;
    background: #eee;
    border-radius: 8rpx;
    margin-right: 20rpx;
}

.info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.desc {
    font-size: 28rpx;
    color: #333;
    margin-bottom: 8rpx;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
}

.time {
    font-size: 24rpx;
    color: #999;
}

.price-info {
    text-align: right;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.price {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

.count {
    font-size: 24rpx;
    color: #999;
}

.footer {
    display: flex;
    justify-content: flex-end;
    padding-top: 20rpx;
    border-top: 1rpx solid #f5f5f5;
}

.btn {
    font-size: 26rpx;
    height: 56rpx;
    line-height: 54rpx;
    padding: 0 24rpx;
    border-radius: 28rpx;
    margin: 0;
    margin-left: 20rpx;
}

.btn.primary {
    background: #0022AB;
    color: #fff;
}

.btn.outline {
    background: #fff;
    color: #0022AB;
    border: 1rpx solid #0022AB;
}

.empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 200rpx;
}

.empty-img {
    width: 200rpx;
    opacity: 0.5;
    margin-bottom: 20rpx;
}

.empty text {
    font-size: 28rpx;
    color: #999;
    margin-bottom: 40rpx;
}

.go-menu-btn {
    background: #0022AB;
    color: #fff;
    font-size: 28rpx;
    padding: 0 60rpx;
    border-radius: 40rpx;
}