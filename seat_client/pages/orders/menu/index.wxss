/* seat_client/pages/menu/index.wxss */
.container {
    display: flex; flex-direction: column; height: 100vh; overflow: hidden;
    background-color: #fff;
}

/* --- 搜索栏 --- */
.header {
    background: #fff;
    padding-bottom: 10rpx;
    z-index: 20;
    box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.02); /* 极淡阴影 */
}
.search-bar { padding: 16rpx 30rpx; }
.search-input-wrapper {
    background: #F5F6FA;
    height: 72rpx;
    border-radius: 36rpx;
    display: flex;
    align-items: center;
    padding: 0 30rpx;
    transition: all 0.3s;
}
/* 聚焦时高亮搜索框 */
.search-input-wrapper:focus-within {
    background: #fff;
    box-shadow: 0 0 0 2rpx var(--primary-color);
}
.search-input { flex: 1; font-size: 28rpx; color: #333; height: 100%; margin-left: 10rpx; }

/* --- 侧边分类栏 --- */
.main-content { flex: 1; display: flex; overflow: hidden; margin-top: 2rpx; }
.category-sidebar {
    width: 190rpx;
    background: #f7f8fa;
    height: 100%;
}
/* 隐藏滚动条 */
.category-sidebar ::-webkit-scrollbar { width: 0; height: 0; color: transparent; }

.category-item {
    height: 110rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26rpx;
    color: #666;
    position: relative;
    transition: all 0.3s;
}
.category-item.active {
    background: #fff;
    color: var(--primary-color);
    font-weight: bold;
    font-size: 28rpx;
    /* 选中时左上左下圆角，营造层次感 */
    border-radius: 0 20rpx 20rpx 0;
}
.category-item.active::before {
    content: '';
    position: absolute;
    left: 0; top: 35rpx; bottom: 35rpx;
    width: 8rpx;
    background: var(--primary-color);
    border-radius: 0 4rpx 4rpx 0;
}

/* --- 商品列表 --- */
.product-scroll { flex: 1; background: #fff; }
.category-title {
    padding: 30rpx 30rpx 20rpx;
    font-size: 28rpx;
    font-weight: 800;
    color: #1a1a1a;
    background: rgba(255,255,255,0.95);
    position: sticky; top: 0; z-index: 10;
    backdrop-filter: blur(5px);
}

.product-item {
    display: flex;
    padding: 30rpx;
    margin-bottom: 20rpx;
}
.product-image-box {
    width: 180rpx; height: 180rpx;
    margin-right: 24rpx;
    position: relative;
    flex-shrink: 0;
}
.product-img {
    width: 100%; height: 100%;
    border-radius: 16rpx;
    background: #f0f0f0;
    box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05); /* 图片微阴影 */
}

.product-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-bottom: 10rpx;
}
.name {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 8rpx;
}
.desc {
    font-size: 22rpx;
    color: #999;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* 价格与按钮 */
.price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.price-wrapper {
    color: var(--secondary-color);
    font-weight: bold;
    display: flex;
    align-items: baseline;
}
.currency { font-size: 24rpx; margin-right: 2rpx; }
.price { font-size: 40rpx; font-family: 'DIN Alternate', sans-serif; }

.add-btn {
    padding: 0 28rpx;
    height: 52rpx;
    background: var(--primary-color);
    border-radius: 26rpx;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24rpx;
    font-weight: 600;
    box-shadow: 0 6rpx 16rpx rgba(0, 34, 171, 0.25);
    transition: transform 0.1s;
}
.add-btn:active { transform: scale(0.95); }

/* --- 购物车条 (Glassmorphism) --- */
.cart-bar {
    position: fixed; bottom: 30rpx; left: 30rpx; right: 30rpx;
    width: auto; height: 110rpx;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px); /* 毛玻璃 */
    border-radius: 60rpx;
    box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
    z-index: 100;
    padding-right: 10rpx; /* 给按钮留间距 */
}

.cart-icon-wrapper {
    width: 90rpx; height: 90rpx;
    background: #000;
    border-radius: 50%;
    margin-left: 20rpx;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.2);
}
.cart-icon { width: 50rpx; height: 50rpx; filter: invert(1); } /* 翻转白色图标 */

.cart-info { flex: 1; margin-left: 24rpx; }
.total-price { font-size: 40rpx; font-weight: bold; color: #333; font-family: 'DIN Alternate', sans-serif;}

.checkout-btn {
    width: 200rpx; height: 90rpx;
    background: #ccc;
    border-radius: 0 55rpx 55rpx 0; /* 右侧圆角 */
    color: #fff; font-size: 32rpx; font-weight: bold;
    display: flex; align-items: center; justify-content: center;
    border-radius: 50rpx; /* 全圆角胶囊 */
}
.checkout-btn.active {
    background: var(--primary-color);
    box-shadow: 0 4rpx 16rpx rgba(0, 34, 171, 0.3);
}

/* 规格弹窗美化 */
.spec-content {
    border-radius: 40rpx 40rpx 0 0;
    box-shadow: 0 -10rpx 40rpx rgba(0,0,0,0.05);
}
.spec-options { padding: 30rpx 40rpx; }
.option-item {
    background: #F5F6FA;
    border-radius: 12rpx;
    padding: 14rpx 34rpx;
    border: 1px solid transparent;
}
.option-item.active {
    background: #E6F3FF;
    border-color: #0022AB;
    color: #0022AB;
}