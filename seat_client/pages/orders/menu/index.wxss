page { height: 100%; overflow: hidden; background-color: #fff; }
.container { height: 100%; display: flex; flex-direction: column; }

/* 头部 */
.shop-header { padding: 20rpx 30rpx; display: flex; justify-content: space-between; align-items: center; border-bottom: 1rpx solid #f0f0f0; height: 100rpx; box-sizing: border-box; }
.shop-name { font-weight: bold; font-size: 30rpx; color: #333; }
.shop-distance { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.delivery-switch { display: flex; background: #f5f5f5; border-radius: 28rpx; padding: 4rpx; }
.switch-item { padding: 6rpx 20rpx; font-size: 24rpx; color: #666; border-radius: 24rpx; }
.switch-item.active { background: #0022AB; color: #fff; font-weight: bold; }

/* 左右布局 */
.menu-content { flex: 1; display: flex; overflow: hidden; }
.left-menu { width: 180rpx; background: #f7f8fa; height: 100%; }
.menu-item { padding: 30rpx 20rpx; font-size: 26rpx; color: #666; text-align: center; }
.menu-item.active { background: #fff; color: #333; font-weight: bold; border-left: 6rpx solid #0022AB; }

.right-list { flex: 1; height: 100%; }
.category-title { padding: 20rpx 30rpx; font-size: 26rpx; color: #333; font-weight: bold; background: #fff; position: sticky; top: 0; z-index: 1; }
.product-list { padding: 0 30rpx; }

/* 商品卡片 */
.product-item { display: flex; padding: 30rpx 0; border-bottom: 1rpx solid #f9f9f9; }
.prod-img { width: 160rpx; height: 160rpx; border-radius: 12rpx; margin-right: 20rpx; background: #f5f5f5; }
.prod-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.prod-name { font-size: 30rpx; color: #333; font-weight: bold; }
.prod-desc { font-size: 22rpx; color: #999; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
.prod-bottom { display: flex; justify-content: space-between; align-items: center; }
.price-box { display: flex; align-items: baseline; }
.currency { font-size: 24rpx; color: #f95606; font-weight: bold; }
.price { font-size: 36rpx; color: #f95606; font-weight: bold; margin-left: 2rpx; }

/* 选规格按钮 */
.spec-btn {
    background: #0022AB;
    color: #fff;
    font-size: 24rpx;
    padding: 8rpx 24rpx;
    border-radius: 30rpx;
    font-weight: bold;
}

/* 底部购物车 */
.cart-bar { position: fixed; bottom: 30rpx; left: 30rpx; right: 30rpx; height: 100rpx; background: #fff; display: flex; align-items: center; padding: 0 30rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.15); border-radius: 50rpx; z-index: 90; }
.cart-icon-wrap { position: relative; margin-right: 20rpx; }
.cart-icon { width: 70rpx; height: 70rpx; }
.badge { position: absolute; top: -5rpx; right: -5rpx; background: #f95606; color: #fff; font-size: 20rpx; min-width: 30rpx; text-align: center; border-radius: 15rpx; line-height: 30rpx; padding: 0 6rpx; border: 2rpx solid #fff; }
.price-info { flex: 1; }
.total-price { font-size: 36rpx; color: #333; font-weight: bold; }
.tips { font-size: 24rpx; color: #999; }
.pay-btn { background: #0022AB; color: #fff; font-size: 30rpx; border-radius: 40rpx; padding: 0 50rpx; line-height: 80rpx; font-weight: bold; }

/* 规格弹窗样式 */
.spec-modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 100; }
.spec-modal {
    position: fixed; bottom: 0; left: 0; right: 0;
    background: #fff; border-radius: 30rpx 30rpx 0 0;
    z-index: 101;
    padding: 30rpx;
    transform: translateY(100%);
    transition: transform 0.3s;
}
.spec-modal.show { transform: translateY(0); }

.modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30rpx; }
.m-prod-name { font-size: 32rpx; font-weight: bold; color: #333; }
.m-close { font-size: 40rpx; color: #999; padding: 10rpx; line-height: 1; }

.modal-content { max-height: 60vh; }
.m-prod-img { width: 160rpx; height: 160rpx; margin: 0 auto 30rpx; display: block; border-radius: 10rpx; }

.spec-group { margin-bottom: 30rpx; }
.spec-title { font-size: 26rpx; color: #666; margin-bottom: 16rpx; }
.spec-tags { display: flex; flex-wrap: wrap; }
.tag {
    padding: 10rpx 30rpx; background: #f5f5f5;
    color: #333; font-size: 26rpx; border-radius: 8rpx;
    margin-right: 20rpx; margin-bottom: 10rpx;
}
.tag.active { background: rgba(0, 34, 171, 0.1); color: #0022AB; border: 1rpx solid #0022AB; }

.modal-footer { border-top: 1rpx solid #eee; padding-top: 20rpx; display: flex; justify-content: space-between; align-items: center; }
.m-price-box { display: flex; flex-direction: column; }
.m-price-box .price { font-size: 40rpx; color: #f95606; font-weight: bold; }
.m-price-box .selected-desc { font-size: 22rpx; color: #666; }
.m-add-btn { background: #0022AB; color: #fff; padding: 16rpx 60rpx; border-radius: 40rpx; font-weight: bold; font-size: 28rpx; }