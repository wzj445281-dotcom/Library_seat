/* seat_client/pages/index/index.wxss */
.container {
    min-height: 100vh;
    background-color: var(--bg-color);
    padding-bottom: 40rpx;
}

/* --- 骨架屏 (保持逻辑，微调样式) --- */
.skeleton-container {
    position: absolute; top: 0; left: 0; width: 100%; height: 100vh;
    background: #fff; z-index: 999;
}
.skeleton-item {
    background: linear-gradient(90deg, #f2f2f2 25%, #e6e6e6 37%, #f2f2f2 63%);
    background-size: 400% 100%;
    animation: skeleton-loading 1.4s ease infinite;
    border-radius: 8rpx;
}
@keyframes skeleton-loading {
    0% { background-position: 100% 50%; }
    100% { background-position: 0 50%; }
}
/* ...其他骨架屏类保持原布局即可... */

/* --- 真实内容 --- */
.header {
    position: relative;
    width: 100%;
    height: 620rpx; /* 稍微加高，显得大气 */
}

.banner-swiper, .slide-image {
    width: 100%;
    height: 100%;
}

/* 图片底部遮罩：从透明到背景色的平滑过渡 */
.header::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; width: 100%; height: 160rpx;
    background: linear-gradient(to bottom, rgba(247,248,250,0) 0%, var(--bg-color) 100%);
    pointer-events: none;
}

/* 核心内容卡片 - 悬浮设计 */
.content-card {
    position: relative;
    margin: -100rpx 32rpx 0; /* 向上重叠更多 */
    background: #fff;
    border-radius: 32rpx;
    padding: 48rpx 40rpx;
    box-shadow: var(--shadow-float);
    z-index: 10;
}

.store-info {
    margin-bottom: 50rpx;
}

.store-name {
    font-size: 44rpx;
    font-weight: 900;
    color: #1a1a1a;
    margin-bottom: 16rpx;
    display: block;
    line-height: 1.2;
}

.store-address {
    font-size: 26rpx;
    color: #666;
    display: flex;
    align-items: center;
    background: #f5f5f5;
    padding: 10rpx 20rpx;
    border-radius: 12rpx;
    display: inline-flex; /* 包裹内容 */
}

.icon-location {
    font-size: 28rpx;
    margin-right: 8rpx;
    color: var(--primary-color);
}

.distance {
    margin-left: 16rpx;
    padding-left: 16rpx;
    border-left: 1px solid #ddd;
    color: var(--primary-color);
    font-weight: bold;
}

/* 点单按钮区 */
.action-area {
    display: flex;
    gap: 30rpx;
}

.order-btn {
    flex: 1;
    height: 180rpx;
    border-radius: 28rpx;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-left: 40rpx; /* 文字左对齐风格 */
    position: relative;
    overflow: hidden;
    transition: transform 0.1s;
    box-shadow: var(--shadow-sm);
}
.order-btn:active {
    transform: scale(0.97);
}

/* 按钮图标 - 绝对定位到右下角，做装饰 */
.order-btn .icon {
    position: absolute;
    right: 20rpx;
    bottom: 20rpx;
    width: 80rpx;
    height: 80rpx;
    opacity: 0.9;
}

/* 到店取 */
.order-btn.ziqu {
    background: linear-gradient(135deg, #E6F3FF 0%, #FFFFFF 100%);
    border: 1px solid rgba(0, 34, 171, 0.05);
}
.order-btn.ziqu .btn-title { color: #0022AB; }
.order-btn.ziqu .btn-desc { color: rgba(0, 34, 171, 0.6); }

/* 外卖配送 */
.order-btn.waimai {
    background: linear-gradient(135deg, #FFF0F0 0%, #FFFFFF 100%);
    border: 1px solid rgba(217, 48, 37, 0.05);
}
.order-btn.waimai .btn-title { color: #D93025; }
.order-btn.waimai .btn-desc { color: rgba(217, 48, 37, 0.6); }

.btn-title {
    font-size: 36rpx;
    font-weight: 800;
    margin-bottom: 8rpx;
    z-index: 1;
}

.btn-desc {
    font-size: 24rpx;
    font-weight: 500;
    z-index: 1;
}