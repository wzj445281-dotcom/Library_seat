.container {
    min-height: 100vh;
    background-color: #f7f7f7;
    padding: 20rpx;
    padding-bottom: 40rpx;
    box-sizing: border-box;
}

/* --- 顶部状态卡片 --- */
.status-card {
    background: #fff;
    border-radius: 16rpx;
    padding: 40rpx 30rpx;
    margin-bottom: 20rpx;
    text-align: center;
    box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.status-header {
    margin-bottom: 30rpx;
}

.status-text {
    display: block;
    font-size: 40rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 12rpx;
}

.status-desc {
    font-size: 26rpx;
    color: #999;
}

/* --- 取餐码区域 --- */
.pickup-code-area {
    margin: 40rpx 0;
    padding: 30rpx 0;
    border-top: 1rpx dashed #eee;
    border-bottom: 1rpx dashed #eee;
}

.pickup-code-area .label {
    display: block;
    font-size: 26rpx;
    color: #666;
    margin-bottom: 16rpx;
}

.pickup-code-area .code {
    font-size: 72rpx;
    font-weight: bold;
    color: #0022AB; /* 瑞幸蓝核心色 */
    letter-spacing: 6rpx;
    display: block;
    margin-bottom: 20rpx;
    font-family: monospace; /* 等宽字体显得更像码 */
}



/* --- 进度条 (Steps) --- */
.progress-steps {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 40rpx;
    padding: 0 40rpx;
}

.step-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: #ccc;
    font-size: 24rpx;
    position: relative;
    z-index: 2;
    width: 100rpx; /* 固定宽度确保文字居中 */
}

.step-item .dot {
    width: 20rpx;
    height: 20rpx;
    background: #eee;
    border-radius: 50%;
    margin-bottom: 14rpx;
    border: 4rpx solid #fff;
    transition: all 0.3s;
}

.line {
    flex: 1;
    height: 4rpx;
    background: #eee;
    margin: 0 -20rpx 38rpx; /* 负margin让线连接到点下方，并上移 */
    position: relative;
    top: -10rpx; /* 微调垂直位置对齐圆点中心 */
    z-index: 1;
    transition: all 0.3s;
}

/* 激活状态 */
.step-item.active {
    color: #0022AB;
    font-weight: bold;
}

.step-item.active .dot {
    background: #0022AB;
    box-shadow: 0 0 0 6rpx rgba(0, 34, 171, 0.15); /* 柔和光晕 */
}

.line.active {
    background: #0022AB;
}


/* --- 订单内容列表 --- */
.order-content, .order-info-card {
    background: #fff;
    border-radius: 16rpx;
    padding: 30rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.02);
}

.shop-name {
    font-size: 30rpx;
    font-weight: bold;
    margin-bottom: 20rpx;
    display: block;
    padding-bottom: 20rpx;
    border-bottom: 1rpx solid #f9f9f9;
}

.order-item {
    display: flex;
    margin-bottom: 30rpx;
}

.item-img {
    width: 110rpx;
    height: 110rpx;
    border-radius: 8rpx;
    background: #eee;
    margin-right: 20rpx;
}

.item-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
}

.item-name {
    font-size: 28rpx;
    color: #333;
    font-weight: 500;
}

.item-spec {
    font-size: 22rpx;
    color: #999;
}

.item-right {
    text-align: right;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
}

.item-count {
    font-size: 24rpx;
    color: #999;
}

.item-price {
    font-size: 28rpx;
    color: #333;
    font-weight: bold;
}

.order-total {
    border-top: 1rpx solid #f9f9f9;
    padding-top: 24rpx;
    text-align: right;
    font-size: 26rpx;
    color: #666;
}

.total-price {
    font-size: 36rpx;
    color: #333;
    font-weight: bold;
    margin-left: 10rpx;
}

/* --- 订单基础信息 --- */
.info-row {
    display: flex;
    justify-content: space-between;
    font-size: 26rpx;
    margin-bottom: 24rpx;
    line-height: 1.4;
}

.info-row:last-child {
    margin-bottom: 0;
}

.info-row .label {
    color: #999;
    width: 140rpx;
}

.info-row .value {
    color: #333;
    flex: 1;
    text-align: right;
    word-break: break-all;
}

.copy-btn {
    margin-left: 16rpx;
    color: #0022AB;
    font-size: 22rpx;
    padding: 4rpx 12rpx;
    border: 1rpx solid #0022AB;
    border-radius: 6rpx;
    display: inline-block;
}