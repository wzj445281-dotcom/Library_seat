<view class="container">
  <!-- 顶部状态栏 & 取餐码 -->
  <view class="status-card">
    <view class="status-header">
      <text class="status-text">{{order.statusText}}</text>
      <text class="status-desc">{{order.statusDesc}}</text>
    </view>

    <!-- 取餐码区域 (仅在制作中或待取餐状态显示) -->
    <view class="pickup-code-area" wx:if="{{order.status === 'MAKING' || order.status === 'WAIT_PICKUP'}}">
      <text class="label">取餐码</text>
      <text class="code">{{order.pickupCode}}</text>
      <view class="qrcode-placeholder">
        <!-- 实际项目中这里可以使用 canvas 绘制二维码，暂时用图片占位 -->
        <!-- 使用本地图片或网络图片占位，这里使用一个通用的二维码图标 -->
        <image src="/assets/images/user.png" mode="aspectFit" class="qr-img" style="opacity: 0.2;"></image>
        <text class="qr-tip">请凭码取餐</text>
      </view>
    </view>

    <!-- 制作进度条 (Steps) -->
    <view class="progress-steps">
      <!-- Step 1 -->
      <view class="step-item {{currentStep >= 0 ? 'active' : ''}}">
        <view class="dot"></view>
        <text>已接单</text>
      </view>

      <!-- Line 1 -->
      <view class="line {{currentStep >= 1 ? 'active' : ''}}"></view>

      <!-- Step 2 -->
      <view class="step-item {{currentStep >= 1 ? 'active' : ''}}">
        <view class="dot"></view>
        <text>制作中</text>
      </view>

      <!-- Line 2 -->
      <view class="line {{currentStep >= 2 ? 'active' : ''}}"></view>

      <!-- Step 3 -->
      <view class="step-item {{currentStep >= 2 ? 'active' : ''}}">
        <view class="dot"></view>
        <text>请取餐</text>
      </view>
    </view>
  </view>

  <!-- 订单内容列表 -->
  <view class="order-content">
    <view class="shop-info">
      <text class="shop-name">{{order.shopName}}</text>
    </view>
    <block wx:for="{{order.items}}" wx:key="id">
      <view class="order-item">
        <image class="item-img" src="{{item.image}}" mode="aspectFill"></image>
        <view class="item-info">
          <text class="item-name">{{item.name}}</text>
          <text class="item-spec">{{item.spec}}</text>
        </view>
        <view class="item-right">
          <text class="item-count">x{{item.count}}</text>
          <text class="item-price">¥{{item.price}}</text>
        </view>
      </view>
    </block>
    <view class="order-total">
      <text>共{{order.totalCount}}件商品，实付</text>
      <text class="total-price">¥{{order.totalPrice}}</text>
    </view>
  </view>

  <!-- 订单基础信息 -->
  <view class="order-info-card">
    <view class="info-row">
      <text class="label">下单时间</text>
      <text class="value">{{order.createTime}}</text>
    </view>
    <view class="info-row">
      <text class="label">订单编号</text>
      <text class="value">{{order.orderNo}}</text>
      <text class="copy-btn" bindtap="copyOrderNo">复制</text>
    </view>
    <view class="info-row">
      <text class="label">备注信息</text>
      <text class="value">{{order.remark || '无'}}</text>
    </view>
  </view>
</view>