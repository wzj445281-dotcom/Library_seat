<view class="container">
  <!-- 顶部 Tab -->
  <view class="tabs">
    <view class="tab-item {{currentTab==0?'active':''}}" bindtap="switchTab" data-index="0">全部</view>
    <view class="tab-item {{currentTab==1?'active':''}}" bindtap="switchTab" data-index="1">待支付</view>
    <view class="tab-item {{currentTab==2?'active':''}}" bindtap="switchTab" data-index="2">制作中</view>
    <view class="tab-item {{currentTab==3?'active':''}}" bindtap="switchTab" data-index="3">待取货</view>
  </view>

  <!-- 订单列表 -->
  <scroll-view class="order-list" scroll-y="true" bindscrolltolower="loadMore">
    <block wx:if="{{orderList.length > 0}}">
      <view class="order-card" wx:for="{{orderList}}" wx:key="orderNo" bindtap="goToDetail" data-id="{{item.orderNo}}">
        
        <!-- 头部：店铺名 + 状态 -->
        <view class="card-header">
          <text class="store-name">智座书局 (图书馆店)</text>
          <text class="status-text {{item.statusStyle}}">{{item.statusText}}</text>
        </view>
        
        <!-- 中部：商品概览 -->
        <view class="card-body">
          <scroll-view class="goods-scroll" scroll-x="true">
            <view class="goods-imgs">
              <image wx:for="{{item.products}}" wx:for-item="prod" wx:key="id" 
                     src="{{prod.imgUrl || '/assets/images/book-placeholder.png'}}" mode="aspectFill"></image>
            </view>
          </scroll-view>
          <view class="order-info">
            <text class="total-count">共{{item.totalCount}}件</text>
            <text class="total-price">¥{{item.totalAmount}}</text>
          </view>
        </view>

        <!-- 底部：取货码 或 操作按钮 -->
        <view class="card-footer">
          <!-- 场景A: 待取货显示取货码 -->
          <view wx:if="{{item.status === 'READY' && item.type === 1}}" class="pickup-code-box">
            <text class="label">取货码：</text>
            <text class="code">{{item.pickupCode}}</text>
          </view>
          
          <!-- 场景B: 待支付显示支付按钮 -->
          <view wx:elif="{{item.status === 'PENDING_PAY'}}" class="btn-group">
            <view class="btn cancel" catchtap="cancelOrder" data-id="{{item.orderNo}}">取消</view>
            <view class="btn pay" catchtap="payOrder" data-id="{{item.orderNo}}">去支付</view>
          </view>
          
          <!-- 场景C: 其他状态显示时间 -->
          <view wx:else class="order-time">{{item.createTime}}</view>
        </view>
      </view>
    </block>
    
    <!-- 空状态 -->
    <view wx:else class="empty-state">
      <image src="/assets/images/empty-order.png" mode="widthFix"></image>
      <text>暂无相关订单</text>
    </view>
  </scroll-view>
</view>