<view class="container">
    <!-- 顶部搜索栏 -->
    <view class="search-bar">
        <input class="search-input" placeholder="搜索书名、作者或物资..."
               bindconfirm="doSearch" bindinput="handleSearchInput" value="{{searchKey}}"/>
        <view class="search-btn" bindtap="doSearch">搜索</view>
    </view>

    <!-- 分类 Tabs -->
    <view class="tabs">
        <view class="tab {{activeTab==0?'active':''}}" bindtap="switchTab" data-idx="0">
            <text>📚 图书馆藏</text>
        </view>
        <view class="tab {{activeTab==1?'active':''}}" bindtap="switchTab" data-idx="1">
            <text>🔋 共享物资</text>
        </view>
    </view>

    <!-- 列表区域 (底部留出购物车高度) -->
    <scroll-view scroll-y class="list-area" style="padding-bottom: 120rpx;">
        <block wx:for="{{list}}" wx:key="id">
            <view class="resource-card">
                <view class="img-box">
                    <image src="{{item.imgUrl || (activeTab==0 ? '/assets/images/book-default.png' : '/assets/images/power-default.png')}}" mode="aspectFill"></image>
                </view>

                <view class="info-box">
                    <view class="title">{{item.name}}</view>
                    <view class="meta" wx:if="{{activeTab == 0}}">作者: {{item.author || '佚名'}}</view>
                    <view class="meta">位置: {{item.locationCode || '前台'}}</view>

                    <view class="row-between">
                        <view class="stock-tag {{item.stock>0?'green':'red'}}">剩余: {{item.stock}}</view>
                        <!-- 改为加入购物车按钮 -->
                        <view class="add-btn {{item.stock<=0?'disabled':''}}"
                              bindtap="handleAddToCart" data-item="{{item}}">
                            <text wx:if="{{item.stock>0}}">+ 加入借阅篮</text>
                            <text wx:else>缺货</text>
                        </view>
                    </view>
                </view>
            </view>
        </block>
        <view wx:if="{{list.length === 0}}" class="empty-tip">未找到相关资源</view>
    </scroll-view>

    <!-- 购物车遮罩层 -->
    <view class="mask" wx:if="{{showCartDetail}}" bindtap="toggleCart"></view>

    <!-- 购物车详情弹窗 -->
    <view class="cart-detail-popup" wx:if="{{showCartDetail}}">
        <view class="cart-header">
            <text>已选资源 ({{cartCount}})</text>
            <text class="clear-btn" bindtap="toggleCart">收起</text>
        </view>
        <scroll-view scroll-y class="cart-scroll">
            <view class="cart-item" wx:for="{{cartList}}" wx:key="id">
                <view class="cart-name">{{item.name}}</view>
                <view class="cart-action" bindtap="handleRemoveFromCart" data-item="{{item}}">移除</view>
            </view>
        </scroll-view>
    </view>

    <!-- 底部悬浮购物车条 -->
    <view class="cart-bar">
        <view class="cart-icon-wrap" bindtap="toggleCart">
            <image src="/assets/images/cart.png" class="cart-icon"></image>
            <view class="badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
        </view>
        <view class="cart-info" bindtap="toggleCart">
            <text class="total-text" wx:if="{{cartCount > 0}}">已选 {{cartCount}} 件物品</text>
            <text class="empty-text" wx:else>借阅篮是空的</text>
        </view>
        <view class="submit-btn {{cartCount > 0 ? 'active' : ''}}" bindtap="handleSubmitCart">
            去借阅
        </view>
    </view>
</view>