page { background: #f7f8fa; height: 100%; }

/* ... 原有搜索和Tab样式保持不变 ... */
.search-bar { background: white; padding: 20rpx 30rpx; display: flex; align-items: center; position: sticky; top: 0; z-index: 10; }
.search-input { flex: 1; background: #f2f2f2; height: 70rpx; border-radius: 35rpx; padding: 0 30rpx; font-size: 28rpx; }
.search-btn { margin-left: 20rpx; font-size: 28rpx; color: #1296db; font-weight: bold; }

.tabs { display: flex; background: white; border-bottom: 1rpx solid #eee; padding: 10rpx 0; }
.tab { flex: 1; text-align: center; padding: 20rpx 0; font-size: 30rpx; color: #666; position: relative; }
.tab.active { color: #1296db; font-weight: bold; }
.tab.active::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 40rpx; height: 6rpx; background: #1296db; border-radius: 3rpx; }

.list-area { height: calc(100vh - 200rpx); padding: 20rpx; box-sizing: border-box; }

/* 卡片样式微调 */
.resource-card { background: white; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; display: flex; align-items: center; }
.img-box { width: 120rpx; height: 160rpx; background: #eee; border-radius: 8rpx; margin-right: 24rpx; flex-shrink: 0; }
.img-box image { width: 100%; height: 100%; border-radius: 8rpx; }
.info-box { flex: 1; display: flex; flex-direction: column; justify-content: space-between; height: 150rpx; }
.title { font-size: 30rpx; font-weight: bold; color: #333; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.meta { font-size: 24rpx; color: #999; }
.row-between { display: flex; justify-content: space-between; align-items: center; margin-top: 10rpx; }
.stock-tag { font-size: 22rpx; padding: 2rpx 10rpx; border-radius: 6rpx; }
.stock-tag.green { background: #e6f7ff; color: #1890ff; }
.stock-tag.red { background: #fff1f0; color: #ff4d4f; }

.add-btn { background: #1296db; color: white; font-size: 24rpx; padding: 10rpx 20rpx; border-radius: 30rpx; }
.add-btn.disabled { background: #ccc; }

/* 购物车悬浮条 */
.cart-bar {
    position: fixed; bottom: 0; left: 0; width: 100%; height: 100rpx; background: #fff;
    display: flex; align-items: center; z-index: 100; box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}
.cart-icon-wrap {
    position: relative; width: 100rpx; height: 100rpx; margin-left: 30rpx; margin-top: -30rpx;
    background: #fff; border-radius: 50%; display: flex; justify-content: center; align-items: center;
    box-shadow: 0 -2rpx 6rpx rgba(0,0,0,0.1);
}
.cart-icon { width: 60rpx; height: 60rpx; }
.badge {
    position: absolute; top: 0; right: 0; background: #ff4d4f; color: white;
    font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 20rpx;
}
.cart-info { flex: 1; padding-left: 20rpx; }
.total-text { font-size: 32rpx; color: #333; font-weight: bold; }
.empty-text { font-size: 28rpx; color: #999; }
.submit-btn {
    width: 240rpx; height: 100%; background: #ccc; color: white;
    display: flex; justify-content: center; align-items: center; font-size: 32rpx; font-weight: bold;
}
.submit-btn.active { background: #1296db; }

/* 购物车详情弹窗 */
.mask { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 90; }
.cart-detail-popup {
    position: fixed; bottom: 100rpx; left: 0; width: 100%; background: white; z-index: 95;
    border-radius: 20rpx 20rpx 0 0; padding-bottom: 20rpx;
}
.cart-header {
    padding: 20rpx 30rpx; background: #f5f5f5; display: flex; justify-content: space-between;
    font-size: 28rpx; color: #666; border-radius: 20rpx 20rpx 0 0;
}
.cart-scroll { max-height: 400rpx; }
.cart-item {
    display: flex; justify-content: space-between; align-items: center;
    padding: 20rpx 30rpx; border-bottom: 1rpx solid #eee;
}
.cart-name { font-size: 30rpx; color: #333; }
.cart-action { color: #ff4d4f; font-size: 26rpx; padding: 10rpx; }

