page {
    background-color: #f5f7fa;
    height: 100%;
}

.chat-container {
    display: flex;
    flex-direction: column;
    height: 100vh;
}

.chat-list {
    flex: 1;
    padding: 20rpx;
    box-sizing: border-box;
    overflow-y: auto;
}

.message-item {
    display: flex;
    margin-bottom: 30rpx;
    align-items: flex-start;
}

.message-item.robot {
    flex-direction: row;
}

.message-item.user {
    flex-direction: row-reverse;
}

.avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    background-color: #ddd;
    margin: 0 20rpx;
    flex-shrink: 0;
}

.content-wrapper {
    max-width: 60%;
}

.content {
    padding: 20rpx;
    font-size: 28rpx;
    line-height: 1.5;
    border-radius: 12rpx;
    word-wrap: break-word;
    word-break: break-all;
}

.robot .content {
    background-color: #ffffff;
    color: #333;
    border-top-left-radius: 0;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.user .content {
    background-color: #007aff;
    color: #ffffff;
    border-top-right-radius: 0;
}

.loading-wrapper {
    text-align: center;
    padding: 20rpx;
}

.loading-text {
    font-size: 24rpx;
    color: #999;
}

.input-area {
    height: 100rpx;
    background-color: #ffffff;
    border-top: 1rpx solid #eaeaea;
    display: flex;
    align-items: center;
    padding: 0 20rpx;
    position: fixed;
    bottom: 0;
    width: 100%;
    box-sizing: border-box;
    z-index: 99;
}

.input-box {
    flex: 1;
    height: 70rpx;
    background-color: #f0f0f0;
    border-radius: 35rpx;
    padding: 0 30rpx;
    font-size: 28rpx;
    margin-right: 20rpx;
}

.send-btn {
    width: 140rpx;
    height: 70rpx;
    line-height: 70rpx;
    background-color: #007aff;
    color: white;
    font-size: 28rpx;
    border-radius: 35rpx;
    padding: 0;
    margin: 0;
}

.send-btn:active {
    opacity: 0.8;
}

.send-btn[disabled] {
    background-color: #a0cfff;
}