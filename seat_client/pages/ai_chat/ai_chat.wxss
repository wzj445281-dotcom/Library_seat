/* 统一主题色：瑞幸蓝 #0022AB */
page {
    background-color: #f5f7fa;
    height: 100%;
}

.chat-container {
    display: flex;
    flex-direction: column;
    height: 100vh;
    background-color: #f5f7fa;
}

.chat-list {
    flex: 1;
    padding: 30rpx 24rpx;
    box-sizing: border-box;
    overflow-y: auto;
}

.message-item {
    display: flex;
    margin-bottom: 40rpx;
    align-items: flex-start;
}

.message-item.robot {
    flex-direction: row;
}

.message-item.user {
    flex-direction: row-reverse;
}

.avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    background-color: #fff;
    margin: 0 20rpx;
    flex-shrink: 0;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.content-wrapper {
    max-width: 70%;
}

.content {
    padding: 24rpx 28rpx;
    font-size: 28rpx;
    line-height: 1.6;
    border-radius: 20rpx;
    word-wrap: break-word;
    word-break: break-all;
}

.robot .content {
    background-color: #ffffff;
    color: #333;
    border-top-left-radius: 8rpx;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.user .content {
    background: linear-gradient(135deg, #0022AB 0%, #0044CC 100%);
    color: #ffffff;
    border-top-right-radius: 8rpx;
    box-shadow: 0 4rpx 12rpx rgba(0, 34, 171, 0.2);
}

/* 推荐商品区域 */
.recommendations {
    margin-top: 24rpx;
    padding-top: 24rpx;
    border-top: 1rpx solid #f0f0f0;
}

.recommend-title {
    font-size: 24rpx;
    color: #666;
    margin-bottom: 20rpx;
    font-weight: 500;
}

.recommend-scroll {
    white-space: nowrap;
    width: 100%;
}

.recommend-list {
    display: inline-flex;
    gap: 20rpx;
    padding-bottom: 10rpx;
}

.recommend-item {
    display: inline-flex;
    flex-direction: column;
    width: 220rpx;
    background: #fff;
    border-radius: 12rpx;
    overflow: hidden;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.rec-image {
    width: 220rpx;
    height: 220rpx;
    background-color: #f5f5f5;
}

.rec-info {
    padding: 16rpx;
    display: flex;
    flex-direction: column;
}

.rec-name {
    font-size: 26rpx;
    color: #333;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.rec-price {
    font-size: 28rpx;
    color: #0022AB;
    font-weight: bold;
    margin: 4rpx 0;
}

.rec-reason {
    font-size: 20rpx;
    color: #999;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* 加载动画 */
.loading-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 30rpx;
    gap: 12rpx;
}

.loading-dot {
    width: 12rpx;
    height: 12rpx;
    border-radius: 50%;
    background-color: #0022AB;
    animation: loading 1.4s infinite ease-in-out both;
}

.loading-dot:nth-child(1) { animation-delay: -0.32s; }
.loading-dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes loading {
    0%, 80%, 100% { transform: scale(0); opacity: 0.5; }
    40% { transform: scale(1); opacity: 1; }
}

.loading-text {
    font-size: 24rpx;
    color: #999;
    margin-left: 10rpx;
}

/* 底部输入框 */
.input-area {
    min-height: 100rpx;
    background-color: #ffffff;
    border-top: 1rpx solid #eaeaea;
    display: flex;
    align-items: center;
    padding: 20rpx 24rpx;
    padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 99;
}

.input-box {
    flex: 1;
    height: 72rpx;
    background-color: #f5f5f5;
    border-radius: 36rpx;
    padding: 0 32rpx;
    font-size: 28rpx;
    margin-right: 20rpx;
    color: #333;
}

.send-btn {
    width: 120rpx;
    height: 72rpx;
    line-height: 72rpx;
    background: linear-gradient(135deg, #0022AB 0%, #0044CC 100%);
    color: white;
    font-size: 28rpx;
    border-radius: 36rpx;
    padding: 0;
    margin: 0;
}

.send-btn[disabled] {
    background: #ccc;
    color: #fff;
}