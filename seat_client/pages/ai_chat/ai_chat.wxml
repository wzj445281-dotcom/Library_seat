<view class="chat-container">
    <scroll-view
            class="chat-list"
            scroll-y="true"
            scroll-top="{{scrollTop}}"
            scroll-with-animation="true">

        <block wx:for="{{messageList}}" wx:key="index">

            <view class="message-item user" wx:if="{{item.role === 'user'}}">
                <view class="content-wrapper">
                    <view class="content">
                        <text user-select="true">{{item.content}}</text>
                    </view>
                </view>
                <image class="avatar" src="/assets/images/user.png" mode="aspectFill"></image>
            </view>

            <view class="message-item ai" wx:else>
                <image class="avatar" src="/assets/images/logo.png" mode="aspectFill"></image>
                <view class="content-wrapper">
                    <view class="content">
                        <text user-select="true">{{item.content}}</text>
                    </view>

                    <view class="recommend-list" wx:if="{{item.recommendations && item.recommendations.length > 0}}">
                        <view class="recommend-item"
                              wx:for="{{item.recommendations}}"
                              wx:for-item="prod"
                              wx:key="pid"
                              bindtap="onProductClick"
                              data-item="{{prod}}">
                            <image class="prod-img" src="{{prod.image}}" mode="aspectFill"></image>
                            <view class="prod-info">
                                <view class="prod-name">{{prod.name}}</view>
                                <view class="prod-price">¥{{prod.price}}</view>
                                <view class="prod-reason" wx:if="{{prod.reason}}">{{prod.reason}}</view>
                            </view>
                        </view>
                    </view>
                </view>
            </view>

        </block>

        <view class="loading-wrapper" wx:if="{{loading}}">
            <view class="loading-dot"></view>
            <view class="loading-dot"></view>
            <view class="loading-dot"></view>
            <view class="loading-text">AI 正在思考...</view>
        </view>

        <view style="height: 140rpx;"></view>
    </scroll-view>

    <view class="input-area">
        <input class="input-box"
               value="{{inputValue}}"
               bindinput="onInput"
               bindconfirm="sendMessage"
               placeholder="请输入您的问题..."
               confirm-type="send"
               disabled="{{loading}}"/>
        <button class="send-btn"
                bindtap="sendMessage"
                disabled="{{loading || !inputValue}}">发送</button>
    </view>
</view>