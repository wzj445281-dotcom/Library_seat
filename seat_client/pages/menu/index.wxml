<view class="skeleton-wrapper" wx:if="{{loading}}">
  <view class="sk-left">
    <view class="skeleton-item sk-menu-item" wx:for="{{[1,2,3,4,5,6,7,8]}}" wx:key="*this"></view>
  </view>
  <view class="sk-right">
    <view class="sk-product-box" wx:for="{{[1,2,3,4]}}" wx:key="*this">
      <view class="skeleton-item sk-img"></view>
      <view class="sk-info">
        <view>
          <view class="skeleton-item sk-title"></view>
          <view class="skeleton-item sk-desc"></view>
        </view>
        <view class="sk-price-row">
          <view class="skeleton-item sk-price"></view>
          <view class="skeleton-item sk-add"></view>
        </view>
      </view>
    </view>
  </view>
</view>

<view class="container" wx:else>
  <block wx:for="{{balls}}" wx:key="id">
    <view class="parabola-flyer-outer" hidden="{{!item.inUse}}" style="{{item.styleOuter}}">
      <view class="parabola-flyer-inner" style="{{item.styleInner}}"></view>
    </view>
  </block>

  <view class="header">
    <view class="search-bar">
      <view class="search-input-wrapper">
        <icon class="search-icon" type="search" size="14"></icon>
        <input
                class="search-input"
                placeholder="想喝什么？搜索看看"
                value="{{searchKeyword}}"
                bindinput="onSearchInput"
                bindfocus="onSearchFocus"
                bindblur="onSearchBlur"
                confirm-type="search"
                bindconfirm="onSearchConfirm"
                placeholder-style="color:#999;"
        />
        <view class="search-clear" wx:if="{{searchKeyword}}" bindtap="clearSearch">
          <icon type="clear" size="14"></icon>
        </view>
      </view>
    </view>

    <view class="search-history" wx:if="{{showSearchHistory && searchHistory.length > 0}}">
      <view class="history-header">
        <text class="history-title">历史搜索</text>
        <view class="history-clear-btn" bindtap="clearSearchHistory">
          <text>🗑</text>
        </view>
      </view>
      <view class="history-tags">
        <view
                class="history-tag"
                wx:for="{{searchHistory}}"
                wx:key="*this"
                bindtap="selectHistory"
                data-keyword="{{item}}"
        >
          {{item}}
        </view>
      </view>
    </view>
  </view>

  <view class="main-content">
    <scroll-view scroll-y class="category-sidebar">
      <view
              wx:for="{{categories}}"
              wx:key="*this"
              class="category-item {{index === activeCategory ? 'active' : ''}}"
              bindtap="switchCategory"
              data-index="{{index}}"
      >
        <text class="cat-name">{{item}}</text>
      </view>
    </scroll-view>

    <scroll-view
            scroll-y
            class="product-scroll"
            scroll-into-view="{{scrollIntoView}}"
            scroll-with-animation
    >
      <block wx:for="{{products}}" wx:key="id" wx:for-item="category">
        <view class="category-group" id="{{category.id}}">
          <view class="category-title">{{category.name}}</view>
          <view class="product-list">
            <view class="product-item" wx:for="{{category.items}}" wx:key="id" wx:for-item="product">

              <view class="product-image-box" bindtap="openSpecModal" data-item="{{product}}">
                <image class="product-img" src="{{product.image}}" mode="aspectFill"></image>
                <view class="favorite-btn" catchtap="onToggleFavorite" data-id="{{product.id}}">
                  <text class="heart-icon {{favoriteMap[product.id] ? 'active' : ''}}">❤</text>
                </view>
              </view>

              <view class="product-info">
                <view bindtap="openSpecModal" data-item="{{product}}">
                  <view class="name">{{product.name}}</view>
                  <view class="desc">{{product.desc}}</view>
                </view>
                <view class="price-row">
                  <view class="price-wrapper">
                    <text class="currency">¥</text>
                    <text class="price">{{product.price}}</text>
                  </view>
                  <view class="add-btn" bindtap="openSpecModal" data-item="{{product}}">选规格</view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>
      <view style="height: 180rpx;"></view>
    </scroll-view>
  </view>

  <view class="cart-bar" bindtap="goToCheckout">
    <view class="cart-icon-wrapper {{cartScale}}">
      <image class="cart-icon" src="/assets/images/cart.png" mode="aspectFit"></image>
      <view class="badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
    </view>
    <view class="cart-info">
      <view class="total-price" wx:if="{{cartCount > 0}}">¥{{totalPrice}}</view>
      <view class="empty-tip" wx:else>未选购商品</view>
    </view>
    <view class="checkout-btn {{cartCount > 0 ? 'active' : ''}}">
      去结算
    </view>
  </view>

  <view class="spec-modal-container" wx:if="{{showSpecModal}}">
    <view class="spec-mask" bindtap="closeSpecModal"></view>
    <view class="spec-content">
      <view class="spec-header">
        <image class="spec-img" src="{{specProduct.image}}" mode="aspectFill"></image>
        <view class="spec-info">
          <view class="spec-name">{{specProduct.name}}</view>
          <view class="spec-desc">{{specProduct.desc}}</view>
          <view class="spec-price">¥{{specProduct.price}}</view>
        </view>
        <view class="spec-close" bindtap="closeSpecModal">×</view>
      </view>

      <scroll-view scroll-y class="spec-options">
        <view class="option-group">
          <view class="option-title">温度</view>
          <view class="option-list">
            <view
                    class="option-item {{specSelections.temp === '冰' ? 'active' : ''}}"
                    bindtap="selectSpec" data-type="temp" data-val="冰">冰</view>
            <view
                    class="option-item {{specSelections.temp === '热' ? 'active' : ''}}"
                    bindtap="selectSpec" data-type="temp" data-val="热">热</view>
            <view
                    class="option-item {{specSelections.temp === '常温' ? 'active' : ''}}"
                    bindtap="selectSpec" data-type="temp" data-val="常温">常温</view>
          </view>
        </view>
        <view class="option-group">
          <view class="option-title">糖度</view>
          <view class="option-list">
            <view
                    class="option-item {{specSelections.sugar === '标准糖' ? 'active' : ''}}"
                    bindtap="selectSpec" data-type="sugar" data-val="标准糖">标准糖</view>
            <view
                    class="option-item {{specSelections.sugar === '半糖' ? 'active' : ''}}"
                    bindtap="selectSpec" data-type="sugar" data-val="半糖">半糖</view>
            <view
                    class="option-item {{specSelections.sugar === '不另加糖' ? 'active' : ''}}"
                    bindtap="selectSpec" data-type="sugar" data-val="不另加糖">不另加糖</view>
          </view>
        </view>
      </scroll-view>

      <view class="spec-footer">
        <view class="selected-desc">
          已选：{{specSelections.temp}}/{{specSelections.sugar}}
        </view>
        <view class="confirm-btn" bindtap="confirmAddToCart">加入购物车</view>
      </view>
    </view>
  </view>
</view>