<!-- 骨架屏 -->
<view class="skeleton-wrapper" wx:if="{{loading}}">
  <view class="sk-left">
    <view class="skeleton-item sk-menu-item" wx:for="{{[1,2,3,4,5,6,7,8]}}" wx:key="*this"></view>
  </view>
  <view class="sk-right">
    <view class="sk-product-box" wx:for="{{[1,2,3,4]}}" wx:key="*this">
      <view class="skeleton-item sk-img"></view>
      <view class="sk-info">
        <view>
          <view class="skeleton-item sk-title"></view>
          <view class="skeleton-item sk-desc"></view>
        </view>
        <view class="sk-price-row">
          <view class="skeleton-item sk-price"></view>
          <view class="skeleton-item sk-add"></view>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 真实内容 -->
<view class="container" wx:else>
  <!-- 抛物线动画小球容器 -->
  <block wx:for="{{balls}}" wx:key="id">
    <view
            class="parabola-flyer-outer"
            hidden="{{!item.inUse}}"
            style="{{item.styleOuter}}"
    >
      <view class="parabola-flyer-inner" style="{{item.styleInner}}"></view>
    </view>
  </block>

  <!-- 顶部搜索栏 -->
  <view class="header">
    <view class="search-bar">
      <view class="search-input-wrapper">
        <icon class="search-icon" type="search" size="16"></icon>
        <input 
          class="search-input" 
          placeholder="搜索您喜欢的商品" 
          value="{{searchKeyword}}"
          bindinput="onSearchInput"
          bindfocus="onSearchFocus"
          bindblur="onSearchBlur"
          confirm-type="search"
          bindconfirm="onSearchConfirm"
        />
        <view class="search-clear" wx:if="{{searchKeyword}}" bindtap="clearSearch">
          <icon type="clear" size="16"></icon>
        </view>
      </view>
    </view>
    
    <!-- 搜索历史 -->
    <view class="search-history" wx:if="{{showSearchHistory && searchHistory.length > 0}}">
      <view class="history-header">
        <text class="history-title">搜索历史</text>
        <text class="history-clear" bindtap="clearSearchHistory">清除</text>
      </view>
      <view class="history-tags">
        <view 
          class="history-tag" 
          wx:for="{{searchHistory}}" 
          wx:key="*this"
          bindtap="selectHistory"
          data-keyword="{{item}}"
        >
          {{item}}
        </view>
      </view>
    </view>
  </view>

  <!-- 中间内容区域 (增加 padding-bottom 防止被底部购物车遮挡) -->
  <view class="main-content">
    <scroll-view scroll-y class="category-sidebar">
      <view
              wx:for="{{categories}}"
              wx:key="*this"
              class="category-item {{index === activeCategory ? 'active' : ''}}"
              bindtap="switchCategory"
              data-index="{{index}}"
      >
        {{item}}
      </view>
    </scroll-view>

    <scroll-view
            scroll-y
            class="product-scroll"
            scroll-into-view="{{scrollIntoView}}"
            scroll-with-animation
    >
      <block wx:for="{{products}}" wx:key="id" wx:for-item="category">
        <view class="category-group" id="{{category.id}}">
          <view class="category-title">{{category.name}}</view>
          <view class="product-list">
            <view class="product-item" wx:for="{{category.items}}" wx:key="id" wx:for-item="product">
              <!-- 商品图片区域 -->
              <view class="product-image-box">
                <lazy-image class="product-img" src="{{product.image}}" mode="aspectFill"></lazy-image>
                
                <!-- 收藏按钮 -->
                <view 
                  class="favorite-btn" 
                  catchtap="onToggleFavorite" 
                  data-id="{{product.id}}"
                >
                  <!-- 根据 favoriteMap 判断显示实心还是空心图标 -->
                  <image 
                    src="{{favoriteMap[product.id] ? '/assets/icons/heart-filled.png' : '/assets/icons/heart-outline.png'}}" 
                    class="icon-heart {{favoriteMap[product.id] ? 'animate-bounce' : ''}}" 
                  />
                </view>
              </view>
              <view class="product-info">
                <view>
                  <view class="name">{{product.name}}</view>
                  <view class="desc">{{product.desc}}</view>
                </view>
                <view class="price-row">
                  <text class="price">{{product.price}}</text>
                  <!-- 绑定 addToCart -->
                  <view class="add-btn" bindtap="addToCart" data-item="{{product}}">+</view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>
      <!-- 底部垫高，防止最后几个商品被购物车挡住 -->
      <view style="height: 120rpx;"></view>
    </scroll-view>
  </view>

  <!-- 底部悬浮购物车栏 -->
  <view class="cart-bar">
    <view class="cart-icon-wrapper {{cartScale}}" bindtap="goToCheckout">
      <image class="cart-icon" src="/assets/images/cart.png" mode="aspectFit"></image> <!-- 请确保图片存在，或使用 iconfont -->
      <view class="badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
    </view>
    <view class="cart-info">
      <view class="total-price" wx:if="{{cartCount > 0}}">¥{{totalPrice}}</view>
      <view class="empty-tip" wx:else>未选购商品</view>
    </view>
    <view class="checkout-btn {{cartCount > 0 ? 'active' : ''}}" bindtap="goToCheckout">
      去结算
    </view>
  </view>
</view>