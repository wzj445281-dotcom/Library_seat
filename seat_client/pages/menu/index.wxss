page { height: 100%; overflow: hidden; } 
.container { height: 100%; display: flex; flex-direction: column; background: #fff; } 

/* 头部样式 */ 
.shop-header { padding: 20rpx 30rpx; display: flex; justify-content: space-between; align-items: center; border-bottom: 1rpx solid #f0f0f0; height: 100rpx; box-sizing: border-box; } 
.shop-name { font-weight: bold; font-size: 32rpx; color: #333; } 
.shop-distance { font-size: 22rpx; color: #999; margin-left: 10rpx; } 
.delivery-switch { display: flex; background: #f5f5f5; border-radius: 30rpx; padding: 4rpx; } 
.switch-item { padding: 8rpx 24rpx; font-size: 24rpx; color: #666; border-radius: 26rpx; } 
.switch-item.active { background: #0022AB; color: #fff; font-weight: bold; } /* 瑞幸蓝 */ 

/* 内容区 */ 
.menu-content { flex: 1; display: flex; overflow: hidden; } 

/* 左侧菜单 */ 
.left-menu { width: 180rpx; background: #f7f8fa; height: 100%; } 
.menu-item { padding: 30rpx 20rpx; font-size: 26rpx; color: #666; text-align: center; position: relative; } 
.menu-item.active { background: #fff; color: #333; font-weight: bold; border-left: 6rpx solid #0022AB; } 
.cat-badge { position: absolute; right: 10rpx; top: 50%; transform: translateY(-50%); background: #ff4444; color: #fff; font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 20rpx; } 

/* 右侧商品区 */ 
.right-list { flex: 1; height: 100%; } 
.category-title { padding: 20rpx 30rpx; font-size: 28rpx; font-weight: bold; color: #333; background: #f9f9f9; } 
.product-list { padding: 0 30rpx; } 
.product-item { display: flex; padding: 30rpx 0; border-bottom: 1rpx solid #f0f0f0; } 
.prod-img { width: 120rpx; height: 120rpx; border-radius: 12rpx; margin-right: 20rpx; background: #f5f5f5; } 
.prod-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; } 
.prod-name { font-size: 28rpx; color: #333; font-weight: 500; } 
.prod-desc { font-size: 22rpx; color: #999; margin: 10rpx 0; } 
.prod-bottom { display: flex; justify-content: space-between; align-items: center; } 
.price-box { display: flex; align-items: baseline; } 
.currency { font-size: 22rpx; color: #ff4444; } 
.price { font-size: 32rpx; color: #ff4444; font-weight: bold; } 
.origin-price { font-size: 22rpx; color: #999; text-decoration: line-through; margin-left: 10rpx; } 
.stepper { display: flex; align-items: center; } 
.stepper .btn { width: 50rpx; height: 50rpx; border-radius: 50%; background: #0022AB; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 28rpx; } 
.stepper .btn.minus { background: #f5f5f5; color: #666; } 
.stepper .num { width: 50rpx; text-align: center; font-size: 28rpx; } 
.stepper.small .btn { width: 40rpx; height: 40rpx; font-size: 24rpx; } 
.stepper.small .num { width: 40rpx; font-size: 24rpx; } 

/* 底部购物车 */ 
.cart-bar { position: fixed; bottom: 0; left: 0; right: 0; height: 100rpx; background: #fff; display: flex; align-items: center; padding: 0 30rpx; box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.1); } 
.cart-icon-wrap { position: relative; margin-right: 20rpx; } 
.cart-icon { width: 60rpx; height: 60rpx; } 
.badge { position: absolute; top: -10rpx; right: -10rpx; background: #ff4444; color: #fff; font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 20rpx; } 
.price-info { flex: 1; } 
.total-price { font-size: 32rpx; color: #ff4444; font-weight: bold; } 
.tips { font-size: 22rpx; color: #999; } 
.pay-btn { background: #0022AB; color: #fff; font-size: 28rpx; border-radius: 40rpx; padding: 0 40rpx; line-height: 70rpx; } 

/* 购物车弹窗 */ 
.cart-popup-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 100; } 
.cart-popup { position: fixed; bottom: 100rpx; left: 0; right: 0; background: #fff; border-radius: 20rpx 20rpx 0 0; z-index: 101; } 
.cp-header { padding: 30rpx; display: flex; justify-content: space-between; align-items: center; border-bottom: 1rpx solid #f0f0f0; } 
.cp-header .clear-btn { color: #999; font-size: 26rpx; } 
.cp-item { padding: 30rpx; display: flex; justify-content: space-between; align-items: center; } 
.cp-item .name { font-size: 28rpx; color: #333; } 
.cp-right { display: flex; align-items: center; } 
.cp-item .price { font-size: 28rpx; color: #ff4444; margin-right: 20rpx; }