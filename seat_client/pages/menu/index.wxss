/* 页面整体布局 */
.container {
    display: flex;
    flex-direction: column;
    height: 100vh;
    background-color: #fff;
    position: relative; /* 确保子元素fixed定位准确 */
}

/* 骨架屏相关样式保持不变... */
@keyframes skeleton-blink {
    0% { opacity: 0.6; }
    50% { opacity: 0.3; }
    100% { opacity: 0.6; }
}
.skeleton-wrapper {
    display: flex;
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 100;
    background: #fff;
}
.sk-left { width: 180rpx; height: 100%; background: #f7f7f7; padding-top: 20rpx; }
.sk-right { flex: 1; padding: 20rpx; }
.skeleton-item { background-color: #f2f2f2; animation: skeleton-blink 1.5s infinite ease-in-out; border-radius: 4rpx; }
.sk-menu-item { width: 140rpx; height: 40rpx; margin: 30rpx auto; }
.sk-product-box { display: flex; margin-bottom: 40rpx; }
.sk-img { width: 180rpx; height: 180rpx; border-radius: 8rpx; }
.sk-info { flex: 1; padding-left: 20rpx; display: flex; flex-direction: column; justify-content: space-between; padding-top: 10rpx; padding-bottom: 10rpx; }
.sk-title { width: 80%; height: 32rpx; margin-bottom: 10rpx; }
.sk-desc { width: 60%; height: 24rpx; }
.sk-price-row { display: flex; justify-content: space-between; align-items: flex-end; }
.sk-price { width: 30%; height: 32rpx; }
.sk-add { width: 48rpx; height: 48rpx; border-radius: 50%; }

/* --- 真实内容样式 --- */

.header {
    padding: 20rpx 30rpx;
    background: #fff;
    border-bottom: 1rpx solid #eee;
}

.search-bar {
    background: #f5f5f5;
    height: 64rpx;
    border-radius: 32rpx;
    display: flex;
    align-items: center;
    padding: 0 20rpx;
    color: #999;
    font-size: 26rpx;
}

.main-content {
    flex: 1;
    display: flex;
    overflow: hidden;
    padding-bottom: 100rpx; /* 预留给 Cart Bar 的位置 */
}

/* 左侧分类 */
.category-sidebar {
    width: 180rpx;
    background: #f7f7f7;
    height: 100%;
}

.category-item {
    height: 100rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26rpx;
    color: #666;
    position: relative;
}

.category-item.active {
    background: #fff;
    color: #333;
    font-weight: bold;
}

.category-item.active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 30rpx;
    bottom: 30rpx;
    width: 8rpx;
    background: #0022AB; /* 瑞幸蓝 */
    border-radius: 0 4rpx 4rpx 0;
}

/* 右侧商品 */
.product-scroll {
    flex: 1;
    height: 100%;
    background: #fff;
}

.category-title {
    padding: 20rpx 30rpx;
    font-size: 28rpx;
    font-weight: bold;
    color: #333;
    background: #fff;
    position: sticky; /* 标题吸顶 */
    top: 0;
    z-index: 1;
}

.product-list {
    padding: 0 20rpx;
}

.product-item {
    display: flex;
    padding: 20rpx 0;
    border-bottom: 1rpx solid #f9f9f9;
    align-items: flex-start;
    min-height: 220rpx;
}

.product-image-box {
    position: relative;
    width: 180rpx;
    height: 180rpx;
    flex-shrink: 0;
}

.product-img {
    width: 180rpx;
    height: 180rpx;
    border-radius: 8rpx;
    background: #eee;
    display: block;
}

/* 收藏按钮样式 */
.favorite-btn {
    position: absolute;
    top: 10rpx;
    right: 10rpx;
    width: 48rpx;
    height: 48rpx;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
    z-index: 10;
}

.icon-heart {
    width: 32rpx;
    height: 32rpx;
}

.icon-heart.animate-bounce {
    animation: heart-bounce 0.3s ease-in-out;
}

@keyframes heart-bounce {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.2); }
}

.product-info {
    flex: 1;
    padding-left: 20rpx;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 180rpx;
}

.name {
    font-size: 30rpx;
    font-weight: bold;
    color: #333;
}

.desc {
    font-size: 22rpx;
    color: #999;
    margin-top: 8rpx;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    text-overflow: ellipsis;
    word-break: break-all;
}

.price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.price {
    font-size: 32rpx;
    color: #d93025;
    font-weight: bold;
    line-height: 1;
}

.price::before {
    content: '¥';
    font-size: 24rpx;
    margin-right: 2rpx;
}

.add-btn {
    width: 50rpx;
    height: 50rpx;
    background: #0022AB;
    border-radius: 50%;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 36rpx;
    line-height: 1;
}

/* --- 底部购物车栏 --- */
.cart-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100rpx;
    background: #fff;
    box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
    display: flex;
    align-items: center;
    z-index: 900;
    padding-bottom: env(safe-area-inset-bottom);
}

.cart-icon-wrapper {
    position: relative;
    width: 100rpx;
    height: 100rpx;
    margin-left: 30rpx;
    margin-top: -30rpx; /* 凸起效果 */
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 -2rpx 6rpx rgba(0,0,0,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
}

/* 购物车图标缩放动画 */
.scale-animate {
    animation: scale-up-down 0.2s ease-in-out;
}

@keyframes scale-up-down {
    0% { transform: scale(1); }
    50% { transform: scale(1.2); }
    100% { transform: scale(1); }
}

.cart-icon {
    width: 60rpx;
    height: 60rpx;
}

.badge {
    position: absolute;
    top: 0;
    right: 0;
    background: #d93025;
    color: #fff;
    font-size: 20rpx;
    padding: 2rpx 10rpx;
    border-radius: 20rpx;
    border: 2rpx solid #fff;
}

.cart-info {
    flex: 1;
    margin-left: 20rpx;
}

.total-price {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
}

.empty-tip {
    font-size: 24rpx;
    color: #999;
}

.checkout-btn {
    width: 240rpx;
    height: 100%;
    background: #ccc;
    color: #fff;
    font-size: 32rpx;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
}

.checkout-btn.active {
    background: #0022AB;
}

/* --- 抛物线小球样式 --- */
.parabola-flyer-outer {
    position: fixed;
    z-index: 999;
    width: 30rpx;
    height: 30rpx;
    /* 初始不可见，JS控制显示 */
}

.parabola-flyer-inner {
    width: 100%;
    height: 100%;
    background-color: #0022AB;
    border-radius: 50%;
}