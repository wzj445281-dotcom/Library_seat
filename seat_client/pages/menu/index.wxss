/* --- 保持之前的页面样式 --- */
page {
    font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
    background-color: #fff;
}
.container {
    display: flex; flex-direction: column; height: 100vh; overflow: hidden;
}

/* 骨架屏 */
@keyframes skeleton-blink { 50% { opacity: 0.5; } }
.skeleton-wrapper { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 999; background: #fff; display: flex; }
.sk-left { width: 180rpx; background: #f5f5f5; padding-top: 20rpx; }
.sk-right { flex: 1; padding: 20rpx; }
.skeleton-item { background: #eee; border-radius: 8rpx; animation: skeleton-blink 1.5s infinite; }
.sk-menu-item { height: 40rpx; margin: 30rpx 20rpx; }
.sk-product-box { display: flex; margin-bottom: 40rpx; }
.sk-img { width: 160rpx; height: 160rpx; }
.sk-info { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; justify-content: space-between; }
.sk-title { width: 60%; height: 30rpx; }
.sk-price { width: 30%; height: 30rpx; }

/* 头部搜索 */
.header { background: #fff; border-bottom: 1rpx solid #f0f0f0; z-index: 10; }
.search-bar { padding: 16rpx 30rpx; }
.search-input-wrapper { background: #f5f5f5; height: 64rpx; border-radius: 32rpx; display: flex; align-items: center; padding: 0 24rpx; }
.search-icon { margin-right: 12rpx; opacity: 0.5; }
.search-input { flex: 1; font-size: 26rpx; color: #333; height: 100%; }
.search-clear { padding: 10rpx; opacity: 0.5; }

/* 搜索历史 */
.search-history { padding: 20rpx 30rpx 30rpx; background: #fff; position: absolute; top: 90rpx; left: 0; right: 0; z-index: 20; box-shadow: 0 10rpx 20rpx rgba(0,0,0,0.05); }
.history-header { display: flex; justify-content: space-between; margin-bottom: 20rpx; font-size: 24rpx; color: #999; }
.history-tags { display: flex; flex-wrap: wrap; gap: 16rpx; }
.history-tag { background: #f5f5f5; padding: 8rpx 24rpx; border-radius: 24rpx; font-size: 24rpx; color: #333; }

/* 主体内容 */
.main-content { flex: 1; display: flex; overflow: hidden; }
.category-sidebar { width: 180rpx; background: #f7f7f7; height: 100%; }
.category-item { height: 100rpx; display: flex; align-items: center; justify-content: center; font-size: 26rpx; color: #666; position: relative; transition: all 0.2s; }
.category-item.active { background: #fff; color: #333; font-weight: bold; font-size: 28rpx; }
.category-item.active::before { content: ''; position: absolute; left: 0; top: 32rpx; bottom: 32rpx; width: 6rpx; background: #0022AB; border-radius: 0 4rpx 4rpx 0; }

.product-scroll { flex: 1; background: #fff; }
.category-title { padding: 24rpx 30rpx 10rpx; font-size: 26rpx; font-weight: bold; color: #333; background: #fff; position: sticky; top: 0; z-index: 5; }
.product-list { padding: 0 24rpx; }

.product-item { display: flex; padding: 24rpx 0; border-bottom: 1rpx solid #f9f9f9; }
.product-image-box { position: relative; width: 170rpx; height: 170rpx; flex-shrink: 0; margin-right: 20rpx; }
.product-img { width: 100%; height: 100%; border-radius: 12rpx; background: #f0f0f0; }
.favorite-btn { position: absolute; right: 0; top: 0; width: 50rpx; height: 50rpx; display: flex; justify-content: center; align-items: center; }
.heart-icon { font-size: 32rpx; color: #fff; text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3); transition: color 0.2s; }
.heart-icon.active { color: #ff4d4f; text-shadow: none; }

.product-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.name { font-size: 30rpx; font-weight: bold; color: #333; margin-bottom: 6rpx; }
.desc { font-size: 22rpx; color: #999; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }

.price-row { display: flex; justify-content: space-between; align-items: flex-end; }
.price-wrapper { color: #d93025; font-weight: bold; display: flex; align-items: baseline; }
.currency { font-size: 24rpx; margin-right: 2rpx; }
.price { font-size: 36rpx; font-family: 'DIN Alternate', sans-serif; }

/* 按钮修改为胶囊形状 */
.add-btn {
    padding: 0 24rpx; height: 48rpx;
    background: #0022AB;
    border-radius: 24rpx;
    color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 24rpx; font-weight: bold;
    box-shadow: 0 4rpx 10rpx rgba(0, 34, 171, 0.2);
}
.add-btn:active { transform: scale(0.95); opacity: 0.9; }

/* 购物车栏 */
.cart-bar { position: fixed; bottom: 0; left: 0; width: 100%; height: 100rpx; background: #fff; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06); display: flex; align-items: center; z-index: 100; padding-bottom: env(safe-area-inset-bottom); }
.cart-icon-wrapper { position: relative; margin-left: 32rpx; margin-top: -32rpx; width: 100rpx; height: 100rpx; background: #fff; border-radius: 50%; box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.08); display: flex; align-items: center; justify-content: center; }
.cart-icon { width: 60rpx; height: 60rpx; }
.badge { position: absolute; top: 0; right: 0; background: #ff4d4f; color: #fff; font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 20rpx; border: 2rpx solid #fff; }
.scale-animate { animation: bounce 0.3s; }
@keyframes bounce { 0%, 100% {transform:scale(1);} 50% {transform:scale(1.1);} }

.cart-info { flex: 1; margin-left: 24rpx; }
.total-price { font-size: 36rpx; font-weight: bold; color: #333; font-family: 'DIN Alternate', sans-serif; }
.empty-tip { font-size: 24rpx; color: #999; }

.checkout-btn { width: 240rpx; height: 100%; background: #ccc; color: #fff; font-size: 30rpx; font-weight: bold; display: flex; align-items: center; justify-content: center; transition: background 0.3s; }
.checkout-btn.active { background: #0022AB; }

/* 抛物线小球 */
.parabola-flyer-outer { position: fixed; z-index: 999; width: 30rpx; height: 30rpx; pointer-events: none; }
.parabola-flyer-inner { width: 100%; height: 100%; background: #0022AB; border-radius: 50%; }

/* --- ✅ 新增：规格弹窗样式 --- */
.spec-modal-container {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    z-index: 1000;
}
.spec-mask {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.5);
}
.spec-content {
    position: absolute; bottom: 0; left: 0; width: 100%;
    background: #fff;
    border-radius: 30rpx 30rpx 0 0;
    padding-bottom: env(safe-area-inset-bottom);
    animation: slideUp 0.3s ease-out;
}
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }

.spec-header {
    padding: 30rpx; display: flex; border-bottom: 1rpx solid #eee; position: relative;
}
.spec-img { width: 140rpx; height: 140rpx; border-radius: 12rpx; margin-right: 24rpx; }
.spec-info { flex: 1; display: flex; flex-direction: column; justify-content: space-around; }
.spec-name { font-size: 32rpx; font-weight: bold; color: #333; }
.spec-desc { font-size: 24rpx; color: #999; }
.spec-price { font-size: 36rpx; color: #d93025; font-weight: bold; font-family: 'DIN Alternate', sans-serif; }
.spec-close { position: absolute; top: 20rpx; right: 30rpx; font-size: 40rpx; color: #999; font-weight: 300; }

.spec-options { max-height: 500rpx; padding: 20rpx 30rpx; }
.option-group { margin-bottom: 30rpx; }
.option-title { font-size: 28rpx; color: #666; margin-bottom: 20rpx; }
.option-list { display: flex; flex-wrap: wrap; gap: 20rpx; }
.option-item {
    padding: 12rpx 30rpx; background: #f5f5f5; border-radius: 8rpx;
    font-size: 26rpx; color: #333; border: 2rpx solid transparent;
}
.option-item.active {
    background: rgba(0, 34, 171, 0.05);
    border-color: #0022AB; color: #0022AB; font-weight: bold;
}

.spec-footer {
    padding: 20rpx 30rpx; border-top: 1rpx solid #eee;
    display: flex; justify-content: space-between; align-items: center;
}
.selected-desc { font-size: 24rpx; color: #666; }
.confirm-btn {
    background: #0022AB; color: #fff; padding: 20rpx 60rpx;
    border-radius: 40rpx; font-size: 28rpx; font-weight: bold;
}
.confirm-btn:active { opacity: 0.9; }