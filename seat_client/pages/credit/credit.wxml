<view class="container">
    <view class="header">
        <view class="score-title">当前信用分</view>
        <view class="score-num">100</view> <!-- 这里的 100 最好也从后端取 -->
    </view>

    <view class="log-list">
        <view class="section-title">变动明细</view>

        <block wx:for="{{logs}}" wx:key="id">
            <view class="log-item">
                <view class="log-left">
                    <view class="reason">{{item.reason}}</view>
                    <view class="date">{{item.createTime}}</view>
                </view>
                <view class="log-right {{item.type == 'ADD' ? 'add' : 'reduce'}}">
                    {{item.type == 'ADD' ? '+' : '-'}}{{item.score}}
                </view>
            </view>
        </block>

        <view wx:if="{{logs.length === 0}}" class="empty">暂无变动记录</view>
    </view>
</view>