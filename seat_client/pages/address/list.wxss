.container {
  min-height: 100vh;
  background-color: #f7f7f7;
  padding-bottom: 120rpx;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.address-list {
  padding: 20rpx;
}

.address-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  position: relative;
}

/* 选中态优化：不仅有边框，还有背景色微调 */
.address-card.selected {
  border: 2rpx solid #0022AB;
  background-color: #f7fbff; /* 极淡的蓝色背景 */
  position: relative;
  overflow: hidden;
}

/* 可选：在选中卡片右上角加个三角形角标 (纯CSS实现) */
.address-card.selected::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  border-top: 40rpx solid #0022AB;
  border-left: 40rpx solid transparent;
}

.address-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.address-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 20rpx;
}

.phone {
  font-size: 28rpx;
  color: #666;
  margin-right: 20rpx;
}

/* 默认标签 */
.default-tag {
  background: rgba(0, 34, 171, 0.1);
  color: #0022AB;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-weight: 600;
}

.address-actions {
  display: flex;
  gap: 20rpx;
}

/* 操作按钮优化：改为图标+文字或仅图标，这里优化文字按钮样式 */
.action-btn {
  border: none; /* 去掉边框，更简洁 */
  background: #f5f5f5;
  color: #666;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  margin-left: 10rpx;
  border-radius: 8rpx;
}

.action-btn.delete {
  color: #d93025;
  background: #fff0f0;
}

.address-detail {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.address-footer {
  padding-top: 20rpx;
  border-top: 1rpx solid #f9f9f9;
}

.set-default-btn {
  font-size: 26rpx;
  color: #0022AB;
  padding: 8rpx 16rpx;
  border: 1rpx solid #0022AB;
  border-radius: 8rpx;
}

.empty-state {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}

.footer-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 20rpx;
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

/* 底部添加按钮悬浮感 */
.add-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #0022AB;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(0, 34, 171, 0.25);
  transition: transform 0.1s;
}

.add-btn:active {
  transform: scale(0.98);
}

.add-btn::after {
  border: none;
}

