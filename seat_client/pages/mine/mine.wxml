<view class="container">
    <view class="user-header">
        <view class="user-info" bindtap="handleLogin">
            <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
            <view class="info-text">
                <view class="nickname">
                    {{userInfo.nickName}}
                    <text class="level-tag" wx:if="{{isLogin}}">Lv.{{userInfo.level}}</text>
                </view>
                <view class="tips" wx:if="{{!isLogin}}">登录享受更多会员权益</view>
                <view class="tips" wx:else>再升一级可享免运费</view>
            </view>
        </view>

        <view class="settings-btn" wx:if="{{isLogin}}" catchtap="handleLogout">退出</view>
    </view>

    <view class="stats-card">
        <view class="stat-item">
            <text class="stat-value">{{assets.points}}</text>
            <text class="stat-label">积分</text>
        </view>
        <view class="stat-item" bindtap="navigateToCoupon">
            <text class="stat-value">{{assets.couponCount}}</text>
            <text class="stat-label">优惠券</text>
        </view>
        <view class="stat-item">
            <text class="stat-value">{{assets.balance}}</text>
            <text class="stat-label">钱包</text>
        </view>
    </view>

    <view class="menu-list">
        <block wx:for="{{menuList}}" wx:key="id">
            <view class="menu-item" bindtap="onMenuClick" data-item="{{item}}">
                <view class="menu-left">
                    <text class="menu-icon">{{item.icon}}</text>
                    <text class="menu-title">{{item.title}}</text>
                </view>
                <view class="menu-right">
                    <view class="arrow"></view>
                </view>
            </view>
        </block>
    </view>

    <view class="footer-version">v1.0.0</view>
</view>