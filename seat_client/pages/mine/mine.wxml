<view class="container">
    <view class="header-card">
        <view class="avatar-box">
            <image class="avatar" src="../../assets/images/user-active.png"></image>
        </view>
        <view class="info-box">
            <view class="name">{{userName || '未登录'}}</view>
            <view class="credit-row" bindtap="goToCredit">
                <text class="credit-val">信用分: {{creditScore}}</text>
                <!-- 动态等级标签 -->
                <text class="level-tag {{creditClass}}">{{creditLevel}}</text>
            </view>
        </view>
        <!-- AI 客服入口图标 -->
        <view class="ai-entry" bindtap="goToAiChat">
            <text>🤖 客服</text>
        </view>
    </view>

    <view class="menu-list">
        <view class="menu-item" bindtap="goToCredit">
            <text class="icon">📜</text><text>信用记录</text><text class="arrow">></text>
        </view>
        <view class="menu-item" bindtap="goToFeedback">
            <text class="icon">🔧</text><text>报修反馈</text><text class="arrow">></text>
        </view>
        <view class="menu-item" bindtap="goToAiChat">
            <text class="icon">💬</text><text>智能助手</text><text class="arrow">></text>
        </view>
    </view>

    <view class="list-container">
        <view class="section-title">当前预约</view>
        <block wx:for="{{list}}" wx:key="id">
            <view class="order-card">
                <view class="card-header">
                    <text class="time">{{item.startTime}} 起</text>
                    <text class="status">{{item.statusStr}}</text>
                </view>

                <!-- 只有在使用中(CHECKED_IN)才显示结束按钮 -->
                <view class="card-footer" wx:if="{{item.status === 'CHECKED_IN'}}">
                    <button class="btn-leave" bindtap="handleLeave" data-id="{{item.id}}">
                        结束使用 (释放座位)
                    </button>
                </view>
            </view>
        </block>
    </view>

    <view class="btn-area">
        <button class="btn-logout" bindtap="handleLogout">退出登录</button>
    </view>
</view>