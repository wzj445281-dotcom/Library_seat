<view class="container">
    <!-- 头部个人卡片 -->
    <view class="header-card">
        <view class="user-row">
            <view class="avatar-box">
                <!-- 这里的头像可以使用 open-data 或者默认图 -->
                <image class="avatar" src="/assets/images/user-active.png" mode="aspectFill"></image>
            </view>
            <view class="info-box">
                <view class="name">{{userName || '点击登录'}}</view>
                <view class="credit-row">
                    <!-- 根据积分动态显示等级 -->
                    <text class="level-tag">{{creditLevel}}会员</text>
                </view>
            </view>
            <!-- AI 客服入口 -->
            <view class="ai-entry" bindtap="goToAiChat">
                <text>🎧 专属客服</text>
            </view>
        </view>

        <!-- 新增：数据统计栏 (对应 wxss 中的 .stats-row) -->
        <view class="stats-row">
            <view class="stat-item">
                <view class="stat-num">{{stats.totalCups || 0}}</view>
                <view class="stat-label">累计消费(杯)</view>
            </view>
            <view class="line"></view>
            <view class="stat-item">
                <view class="stat-num">¥{{stats.totalSaved || 0}}</view>
                <view class="stat-label">累计节省</view>
            </view>
            <view class="line"></view>
            <view class="stat-item">
                <view class="stat-num">{{creditScore}}</view>
                <view class="stat-label">当前积分</view>
            </view>
        </view>
    </view>

    <!-- 功能菜单 -->
    <view class="menu-list">
        <view class="menu-item" bindtap="navigateToOrders">
            <view class="item-left">
                <!-- 使用 Emoji 作为简单图标，或替换为 image -->
                <text class="menu-icon-text">📄</text>
                <text>我的订单</text>
            </view>
            <text class="arrow">></text>
        </view>

        <!-- 移除了信用记录入口，增加咖啡钱包入口占位 -->
        <view class="menu-item">
            <view class="item-left">
                <text class="menu-icon-text">☕️</text>
                <text>咖啡钱包</text>
            </view>
            <text class="arrow">></text>
        </view>

        <view class="menu-item" bindtap="goToFeedback">
            <view class="item-left">
                <text class="menu-icon-text">🔧</text>
                <text>帮助反馈</text>
            </view>
            <text class="arrow">></text>
        </view>
    </view>

    <!-- 底部按钮 -->
    <view class="btn-area">
        <button class="btn-logout" bindtap="handleLogout">退出登录</button>
    </view>
</view>