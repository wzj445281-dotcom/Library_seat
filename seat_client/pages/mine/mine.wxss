.container {
    min-height: 100vh;
    background-color: #f7f7f7;
}

/* --- 头部用户信息 --- */
.user-header {
    background-color: #0022AB; /* 瑞幸蓝 */
    padding: 40rpx 40rpx 120rpx; /* 底部留白给 Stats 卡片 */
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #fff;
    position: relative;
}

.user-info {
    display: flex;
    align-items: center;
}

.avatar {
    width: 120rpx;
    height: 120rpx;
    border-radius: 50%;
    border: 4rpx solid rgba(255,255,255,0.3);
    background: #fff;
    margin-right: 30rpx;
}

.info-text {
    display: flex;
    flex-direction: column;
}

.nickname {
    font-size: 36rpx;
    font-weight: bold;
    margin-bottom: 10rpx;
    display: flex;
    align-items: center;
}

.level-tag {
    font-size: 20rpx;
    background: #d4a017; /* 金色 */
    color: #fff;
    padding: 2rpx 10rpx;
    border-radius: 8rpx;
    margin-left: 10rpx;
    font-style: italic;
}

.tips {
    font-size: 24rpx;
    opacity: 0.8;
}

.settings-btn {
    font-size: 24rpx;
    border: 1rpx solid rgba(255,255,255,0.5);
    padding: 6rpx 20rpx;
    border-radius: 24rpx;
    opacity: 0.8;
}

/* --- 资产看板 --- */
.stats-card {
    margin: -80rpx 30rpx 30rpx;
    background: #fff;
    border-radius: 16rpx;
    padding: 30rpx 0;
    display: flex;
    justify-content: space-around;
    box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
    position: relative;
    z-index: 10;
}

.stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    position: relative;
}

.stat-item:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 20%;
    height: 60%;
    width: 1rpx;
    background: #eee;
}

.stat-value {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 8rpx;
}

.stat-label {
    font-size: 24rpx;
    color: #666;
}

/* --- Banner --- */
.banner-area {
    margin: 0 30rpx 30rpx;
    height: 180rpx;
    border-radius: 16rpx;
    overflow: hidden;
}

.banner-img {
    width: 100%;
    height: 100%;
}

/* --- 菜单列表 --- */
.menu-list {
    background: #fff;
    margin: 0 30rpx;
    border-radius: 16rpx;
    padding: 0 20rpx;
}

.menu-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx 10rpx;
    border-bottom: 1rpx solid #f9f9f9;
}

.menu-item:last-child {
    border-bottom: none;
}

.menu-left {
    display: flex;
    align-items: center;
}

.menu-icon {
    font-size: 32rpx;
    margin-right: 20rpx;
}

.menu-title {
    font-size: 30rpx;
    color: #333;
}

.arrow {
    width: 16rpx;
    height: 16rpx;
    border-top: 4rpx solid #ccc;
    border-right: 4rpx solid #ccc;
    transform: rotate(45deg);
}

.footer-version {
    text-align: center;
    color: #ddd;
    font-size: 20rpx;
    margin-top: 40rpx;
    margin-bottom: 20rpx;
}