/* seat_client/pages/mine/mine.wxss */
.container {
    min-height: 100vh;
    background-color: var(--bg-color);
}

/* --- 头部用户信息 --- */
.user-header {
    background: radial-gradient(circle at 10% 20%, #304FFE 0%, #0022AB 100%);
    padding: 60rpx 40rpx 160rpx; /* 增加顶部padding适配全面屏 */
    color: #fff;
    position: relative;
    overflow: hidden;
}

/* 装饰背景圆 */
.user-header::before {
    content: '';
    position: absolute;
    top: -50%; right: -20%;
    width: 400rpx; height: 400rpx;
    background: rgba(255,255,255,0.05);
    border-radius: 50%;
}

.user-info { display: flex; align-items: center; position: relative; z-index: 1; }
.avatar {
    width: 130rpx; height: 130rpx;
    border-radius: 50%;
    border: 6rpx solid rgba(255,255,255,0.2);
    margin-right: 32rpx;
    background: #fff;
}
.nickname { font-size: 40rpx; font-weight: bold; letter-spacing: 1px; }
.level-tag {
    font-size: 20rpx; background: #FFD700; color: #000;
    padding: 4rpx 12rpx; border-radius: 20rpx;
    margin-left: 16rpx; font-weight: 800;
}
.settings-btn {
    background: rgba(0,0,0,0.2);
    padding: 10rpx 24rpx;
    border-radius: 30rpx;
    font-size: 24rpx;
    border: none;
    backdrop-filter: blur(5px);
}

/* --- 资产看板 --- */
.stats-card {
    margin: -100rpx 30rpx 40rpx;
    background: #fff;
    border-radius: 24rpx;
    padding: 40rpx 0;
    display: flex;
    justify-content: space-around;
    box-shadow: var(--shadow-md);
    position: relative;
    z-index: 10;
}
.stat-item {
    display: flex; flex-direction: column; align-items: center; flex: 1;
}
.stat-value {
    font-size: 44rpx;
    font-weight: bold;
    color: #333;
    font-family: 'DIN Alternate', sans-serif;
    margin-bottom: 4rpx;
}
.stat-label { font-size: 24rpx; color: #999; }

/* --- 菜单列表 --- */
.menu-list {
    background: #fff;
    margin: 0 30rpx;
    border-radius: 24rpx;
    padding: 10rpx 0;
    box-shadow: var(--shadow-sm);
}

.menu-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 32rpx 30rpx;
    position: relative;
}
/* 点击波纹效果 */
.menu-item:active { background-color: #f9f9f9; }

.menu-item::after {
    content: '';
    position: absolute; bottom: 0; left: 100rpx; right: 30rpx;
    height: 1px; background: #f5f5f5;
}
.menu-item:last-child::after { display: none; }

.menu-left { display: flex; align-items: center; }

/* 菜单图标容器 */
.menu-icon {
    width: 56rpx; height: 56rpx;
    border-radius: 50%;
    background: #E6F3FF; /* 默认淡蓝底 */
    color: var(--primary-color);
    display: flex; align-items: center; justify-content: center;
    font-size: 28rpx;
    margin-right: 24rpx;
}

/* 也可以根据不同菜单项给不同颜色，这里统一用品牌色显得整洁 */
.menu-title { font-size: 30rpx; color: #333; font-weight: 500; }

.arrow {
    width: 14rpx; height: 14rpx;
    border-top: 4rpx solid #e0e0e0;
    border-right: 4rpx solid #e0e0e0;
    transform: rotate(45deg);
}

.footer-version { margin-top: 60rpx; color: #ccc; }