page { background-color: #f7f8fa; }

.header-card {
    background: #fff;
    padding: 40rpx 30rpx 0;
    margin-bottom: 20rpx;
}

.user-row {
    display: flex;
    align-items: center;
    margin-bottom: 40rpx;
}

.avatar-box {
    width: 110rpx; height: 110rpx;
    border-radius: 50%;
    overflow: hidden;
    margin-right: 24rpx;
    border: 2rpx solid #f0f0f0;
}
.avatar { width: 100%; height: 100%; }

.info-box { flex: 1; }
.name { font-size: 36rpx; font-weight: bold; color: #333; margin-bottom: 10rpx; }
.level-tag {
    font-size: 22rpx;
    background: #333;
    color: #ebdcb8; /* 黑金配色 */
    padding: 4rpx 16rpx;
    border-radius: 6rpx;
}

.ai-entry {
    background: #f2f2f2;
    padding: 10rpx 20rpx;
    border-radius: 30rpx;
    font-size: 24rpx;
    color: #0022AB;
    font-weight: bold;
}

/* 统计数据栏 */
.stats-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 40rpx;
}
.stat-item {
    flex: 1;
    text-align: center;
}
.stat-num {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 6rpx;
}
.stat-label {
    font-size: 24rpx;
    color: #999;
}
.line {
    width: 1rpx;
    height: 30rpx;
    background: #eee;
}

/* 菜单列表 */
.menu-list {
    background: #fff;
    padding: 0 30rpx;
    margin-bottom: 40rpx;
}
.menu-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx 0;
    border-bottom: 1rpx solid #f9f9f9;
}
.menu-item:last-child { border-bottom: none; }

.item-left { display: flex; align-items: center; font-size: 30rpx; color: #333; }
.menu-icon { width: 40rpx; height: 40rpx; margin-right: 20rpx; }
.menu-icon-text { font-size: 36rpx; margin-right: 20rpx; width: 40rpx; text-align: center; }
.arrow { color: #ccc; font-size: 26rpx; }

.btn-area { padding: 0 40rpx; }
.btn-logout {
    background: #fff;
    color: #0022AB;
    border: 2rpx solid #0022AB;
    border-radius: 44rpx;
    font-size: 30rpx;
    font-weight: bold;
}