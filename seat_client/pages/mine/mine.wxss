page {
    background-color: #f5f5f5;
    height: 100%;
}

.container {
    display: flex;
    flex-direction: column;
    height: 100%;
}

/* Tabs 样式 */
.tabs {
    display: flex;
    background: #fff;
    height: 88rpx;
    align-items: center;
    position: relative;
    box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.03);
    z-index: 10;
}

.tab-item {
    flex: 1;
    text-align: center;
    font-size: 28rpx;
    color: #666;
    height: 100%;
    line-height: 88rpx;
    position: relative;
}

.tab-item.active {
    color: #0022AB;
    font-weight: bold;
    font-size: 30rpx;
}

.tab-item.active::after {
    content: '';
    position: absolute;
    bottom: 10rpx;
    left: 50%;
    transform: translateX(-50%);
    width: 40rpx;
    height: 6rpx;
    background: #0022AB;
    border-radius: 4rpx;
}

/* 列表区域 */
.coupon-list {
    flex: 1;
    padding: 24rpx;
    box-sizing: border-box;
}

/* 票券卡片核心样式 */
.coupon-card {
    display: flex;
    background: #fff;
    border-radius: 16rpx;
    height: 200rpx;
    margin-bottom: 24rpx;
    position: relative;
    overflow: hidden;
    box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

/* 左侧价格区 */
.coupon-left {
    width: 200rpx;
    background: linear-gradient(135deg, #0022AB 0%, #0044CC 100%);
    color: #fff;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
}

.price-wrapper {
    display: flex;
    align-items: baseline;
}

.symbol {
    font-size: 32rpx;
    margin-right: 4rpx;
}

.amount {
    font-size: 72rpx;
    font-weight: bold;
    font-family: 'DIN Alternate', sans-serif;
}

.type-tag {
    font-size: 22rpx;
    background: rgba(255,255,255,0.2);
    padding: 4rpx 12rpx;
    border-radius: 20rpx;
    margin-top: 10rpx;
}

/* 右侧详情区 */
.coupon-right {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 30rpx;
}

.info {
    display: flex;
    flex-direction: column;
    gap: 10rpx;
}

.title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

.limit {
    font-size: 24rpx;
    color: #666;
}

.time {
    font-size: 20rpx;
    color: #999;
}

/* 按钮与状态图标 */
.use-btn {
    background: #fff;
    color: #0022AB;
    border: 2rpx solid #0022AB;
    font-size: 26rpx;
    padding: 10rpx 30rpx;
    border-radius: 30rpx;
    font-weight: bold;
}

.use-btn:active {
    background: #f0f7ff;
}

.status-icon {
    width: 110rpx;
    height: 110rpx;
    opacity: 0.6;
}

/* 失效状态变灰 */
.coupon-card.disabled .coupon-left {
    background: #ccc;
}
.coupon-card.disabled .title {
    color: #999;
}

/* 缺口装饰 - 关键代码 */
.circle {
    position: absolute;
    width: 32rpx;
    height: 32rpx;
    background-color: #f5f5f5; /* 与页面背景同色 */
    border-radius: 50%;
    left: 184rpx; /* (左侧宽度200 - 圆宽32/2) */
    z-index: 5;
}
.circle.top { top: -16rpx; }
.circle.bottom { bottom: -16rpx; }

/* 虚线分隔符 (可选) */
.coupon-left::after {
    content: '';
    position: absolute;
    right: 0;
    top: 20rpx;
    bottom: 20rpx;
    border-right: 2rpx dashed rgba(255,255,255,0.3);
}

.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: 150rpx;
    color: #999;
    font-size: 28rpx;
}
.empty-img {
    width: 200rpx;
    height: 200rpx;
    margin-bottom: 30rpx;
}