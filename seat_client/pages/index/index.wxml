<view class="container">
  <!-- 顶部轮播图 -->
  <swiper class="banner-swiper" indicator-dots="true" autoplay="true" interval="4000" circular="true" indicator-active-color="#fff">
    <swiper-item>
      <view class="banner-item bg-blue">
        <text class="banner-text">生酪拿铁</text>
        <text class="banner-sub">年度重磅回归</text>
      </view>
    </swiper-item>
    <swiper-item>
      <view class="banner-item bg-orange">
        <text class="banner-text">新客首杯 9.9</text>
        <text class="banner-sub">不限品类任选</text>
      </view>
    </swiper-item>
  </swiper>

  <!-- 核心入口：到店取/外卖送 -->
  <view class="order-entry-card">
    <view class="entry-item border-right" bindtap="goToMenu" data-type="1">
      <view class="entry-title">到店取</view>
      <view class="entry-desc">提前下单 不排队</view>
      <image class="entry-icon" src="/assets/images/book-default.png" mode="aspectFit"></image> <!-- 暂用现有图标 -->
    </view>
    <view class="entry-item" bindtap="goToMenu" data-type="2">
      <view class="entry-title">幸运送</view>
      <view class="entry-desc">外卖到家 美味直达</view>
      <image class="entry-icon" src="/assets/images/cart.png" mode="aspectFit"></image> <!-- 暂用现有图标 -->
    </view>
  </view>

  <!-- 会员营销 Banner -->
  <view class="member-card" bindtap="goToMine">
    <view class="member-left">
      <view class="member-title">瑞幸会员</view>
      <view class="member-desc">积攒幸运豆，兑换好礼</view>
    </view>
    <view class="member-btn">去查看</view>
  </view>

  <!-- 推荐商品流 (简化版) -->
  <view class="recommend-section">
    <view class="section-title">猜你喜欢</view>
    <view class="recommend-list">
      <view class="rec-item" wx:for="{{recommends}}" wx:key="id" bindtap="goToMenu">
        <image class="rec-img" src="{{item.image || '/assets/images/book-default.png'}}"></image>
        <view class="rec-name">{{item.name}}</view>
        <view class="rec-price">¥{{item.price}}</view>
      </view>
    </view>
  </view>
</view>