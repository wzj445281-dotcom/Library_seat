<view class="container">
  <!-- 顶部状态图例 -->
  <view class="legend-area">
    <view class="legend-item">
      <view class="dot available"></view>
      <text>空闲</text>
    </view>
    <view class="legend-item">
      <view class="dot occupied"></view>
      <text>占用</text>
    </view>
    <view class="legend-item">
      <view class="dot selected"></view>
      <text>已选</text>
    </view>
  </view>

  <!-- 座位地图区域 (可滚动) -->
  <scroll-view scroll-y scroll-x class="map-container">
    <view class="seat-grid">
      <block wx:for="{{seats}}" wx:key="id">
        <!--
          grid-column/row: 控制网格位置
          data-index: 用于点击事件获取当前点击的是第几个座位
        -->
        <view
                class="seat-item {{item.status == 0 ? 'maintenance' : ''}} {{item.id === selectedSeat.id ? 'selected' : ''}}"
                style="grid-column: {{item.gridX}}; grid-row: {{item.gridY}};"
                bindtap="handleSeatClick"
                data-index="{{index}}"
        >
          {{item.label}}
        </view>
      </block>
    </view>
  </scroll-view>
          <view
                  class="seat-item {{item.status == 0 ? 'maintenance' : ''}} {{item.id === selectedSeat.id ? 'selected' : ''}}"
                  style="grid-column: {{item.gridX}}; grid-row: {{item.gridY}};"
                  bindtap="handleSeatClick"
                  data-index="{{index}}"
          >
            <!-- 原有座位号 -->
            <text>{{item.label}}</text>

            <!-- 新增：热度火苗 (绝对定位在右上角) -->
            <view wx:if="{{item.heatScore >= 90}}" class="fire-icon">🔥</view>
          </view>
  <!-- 底部操作栏 -->
  <view class="footer-bar" wx:if="{{selectedSeat}}">
    <view class="seat-info">
      <text class="label">已选座位：</text>
      <text class="value">{{selectedSeat.label}}</text>
    </view>
    <view class="time-info">
      <text>预约时长：2小时 (默认)</text>
    </view>
    <button class="btn-submit" bindtap="handleSubmit">立即预约</button>
  </view>
</view>