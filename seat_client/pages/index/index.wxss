page {
    background-color: #f7f8fa;
    height: 100%;
}

.container {
    display: flex;
    flex-direction: column;
    height: 100vh;
}

/* 顶部图例 */
.legend-area {
    background-color: #fff;
    padding: 20rpx;
    display: flex;
    justify-content: center;
    gap: 40rpx;
    box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
    z-index: 10;
}

.legend-item {
    display: flex;
    align-items: center;
    font-size: 26rpx;
    color: #666;
}

.dot {
    width: 24rpx;
    height: 24rpx;
    border-radius: 6rpx;
    margin-right: 10rpx;
}

.dot.available { background-color: #e6f7ff; border: 1px solid #1890ff; }
.dot.occupied { background-color: #ffccc7; border: 1px solid #ff4d4f; }
.dot.selected { background-color: #52c41a; border: 1px solid #52c41a; }

/* 地图区域 */
.map-container {
    flex: 1;
    padding: 40rpx;
    box-sizing: border-box;
}

.seat-grid {
    display: grid;
    /* 这里的 80rpx 是格子大小，根据实际情况调整 */
    grid-auto-rows: 80rpx;
    grid-auto-columns: 80rpx;
    gap: 20rpx;
    padding-bottom: 200rpx; /* 防止被底部遮挡 */
}

.seat-item {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #e6f7ff;
    border: 1px solid #1890ff;
    color: #1890ff;
    font-size: 24rpx;
    border-radius: 12rpx;
    font-weight: bold;
    transition: all 0.2s;
}

.seat-item.selected {
    background-color: #52c41a;
    border-color: #52c41a;
    color: #fff;
    box-shadow: 0 4rpx 12rpx rgba(82, 196, 26, 0.4);
    transform: scale(1.05);
}

.seat-item.maintenance {
    background-color: #f5f5f5;
    border-color: #d9d9d9;
    color: #ccc;
}

/* 底部栏 */
.footer-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #fff;
    padding: 30rpx 40rpx;
    padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
    box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.08);
    border-top-left-radius: 30rpx;
    border-top-right-radius: 30rpx;
    animation: slideUp 0.3s ease-out;
}

.seat-info {
    font-size: 32rpx;
    font-weight: bold;
    margin-bottom: 10rpx;
}
.seat-info .value { color: #1296db; }

.time-info {
    font-size: 24rpx;
    color: #999;
    margin-bottom: 30rpx;
}

.btn-submit {
    background-color: #1296db;
    color: white;
    border-radius: 50rpx;
    font-size: 30rpx;
    font-weight: bold;
}

@keyframes slideUp {
    from { transform: translateY(100%); }
    to { transform: translateY(0); }
}
.seat-item {
    position: relative; /* 增加相对定位 */
    /* ... existing styles ... */
}

/* 火苗图标样式 */
.fire-icon {
    position: absolute;
    top: -10rpx;
    right: -10rpx;
    font-size: 20rpx;
    background: #fff;
    border-radius: 50%;
    width: 28rpx;
    height: 28rpx;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
    z-index: 5;
}