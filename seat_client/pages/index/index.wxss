/* 保持原有样式，新增骨架屏相关样式 */

.container {
    min-height: 100vh;
    background-color: #f7f7f7;
    padding-bottom: 30rpx;
}

/* 骨架屏容器 */
.skeleton-container {
    padding: 0;
    width: 100%;
    height: 100vh;
    background: #fff;
    overflow: hidden;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 999;
}

/* 骨架屏动画效果 - 呼吸灯 */
@keyframes skeleton-blink {
    0% { opacity: 0.6; }
    50% { opacity: 0.3; }
    100% { opacity: 0.6; }
}

.skeleton-item {
    background-color: #e0e0e0;
    animation: skeleton-blink 1.5s infinite ease-in-out;
    border-radius: 8rpx;
}

/* 首页特定骨架布局 */
.sk-banner {
    width: 100%;
    height: 500rpx; /* 对应头部高度 */
    border-radius: 0 0 20rpx 20rpx;
}

.sk-card {
    margin: -60rpx 30rpx 30rpx;
    background: #fff;
    padding: 30rpx;
    border-radius: 16rpx;
    box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.sk-store-info {
    height: 40rpx;
    width: 60%;
    margin-bottom: 20rpx;
}

.sk-distance {
    height: 30rpx;
    width: 40%;
    margin-bottom: 40rpx;
}

.sk-buttons {
    display: flex;
    justify-content: space-between;
}

.sk-btn {
    width: 48%;
    height: 120rpx;
    border-radius: 12rpx;
}

/* 原有样式保留... */
.header {
    position: relative;
    width: 100%;
    height: 560rpx;
    /* 增加底部遮罩，让图片到底部有个过渡 */
    mask-image: linear-gradient(to bottom, black 90%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 90%, transparent 100%);
}

.banner-swiper {
    width: 100%;
    height: 100%;
}

.slide-image {
    width: 100%;
    height: 100%;
}

.content-card {
    position: relative;
    margin: -80rpx 30rpx 0;
    background: #fff;
    border-radius: 24rpx; /* 加大圆角 */
    padding: 40rpx;
    /* 优化投影：双层投影更有层次感 */
    box-shadow: 0 4rpx 12rpx rgba(0, 34, 171, 0.05), 0 12rpx 32rpx rgba(0, 0, 0, 0.03);
    z-index: 10;
}

.store-info {
    margin-bottom: 40rpx;
}

.store-name {
    font-size: 38rpx; /* 微调大 */
    font-weight: 800; /* 更粗 */
    color: #1a1a1a;
    margin-bottom: 12rpx;
    letter-spacing: 1rpx;
    display: block;
}

.store-address {
    font-size: 26rpx;
    color: #666;
    display: flex;
    align-items: center;
}

.distance {
    margin-left: 20rpx;
    color: #999;
}

.action-area {
    display: flex;
    justify-content: space-between;
    gap: 20rpx;
}

.order-btn {
    flex: 1;
    height: 170rpx; /* 稍微加高 */
    border-radius: 20rpx;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
    transition: transform 0.1s ease; /* 添加按压动画 */
}

/* 添加点击时的缩放效果 */
.order-btn:active {
    transform: scale(0.98);
}

.order-btn.ziqu {
    background: linear-gradient(145deg, #eef7ff 0%, #daedff 100%);
    border: 1rpx solid rgba(0, 34, 171, 0.1); /* 增加微弱边框 */
    color: #0022AB;
}

.order-btn.waimai {
    background: linear-gradient(145deg, #fff5f5 0%, #ffe0e0 100%);
    border: 1rpx solid rgba(217, 48, 37, 0.1);
    color: #d93025;
}

.btn-title {
    font-size: 34rpx;
    font-weight: 700;
    margin-bottom: 6rpx;
}

.btn-desc {
    font-size: 22rpx;
    opacity: 0.7;
    font-weight: 500;
}

.icon {
    width: 56rpx;
    height: 56rpx;
    margin-bottom: 12rpx;
}