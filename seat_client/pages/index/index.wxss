page {
    background-color: #f7f8fa;
}

.container {
    padding-bottom: 40rpx;
}

/* 轮播图 */
.banner-swiper {
    width: 100%;
    height: 420rpx;
}
.banner-item {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    color: white;
}
.bg-blue { background: #0022AB; }
.bg-orange { background: #ff8800; }

.banner-text { font-size: 48rpx; font-weight: bold; margin-bottom: 10rpx; }
.banner-sub { font-size: 28rpx; opacity: 0.9; }

/* 核心入口卡片 */
.order-entry-card {
    margin: -40rpx 30rpx 20rpx;
    background: white;
    border-radius: 16rpx;
    padding: 40rpx 0;
    display: flex;
    box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
    position: relative;
    z-index: 10;
}
.entry-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}
.border-right { border-right: 1rpx solid #eee; }

.entry-title { font-size: 36rpx; font-weight: bold; color: #333; margin-bottom: 8rpx; }
.entry-desc { font-size: 24rpx; color: #999; margin-bottom: 20rpx; }
.entry-icon { width: 80rpx; height: 80rpx; }

/* 会员卡片 */
.member-card {
    margin: 20rpx 30rpx;
    background: #333;
    border-radius: 16rpx;
    padding: 30rpx 40rpx;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #ebdcb8; /* 黑金配色 */
}
.member-title { font-size: 32rpx; font-weight: bold; margin-bottom: 6rpx; }
.member-desc { font-size: 24rpx; opacity: 0.8; }
.member-btn {
    font-size: 24rpx;
    border: 1rpx solid #ebdcb8;
    padding: 8rpx 20rpx;
    border-radius: 30rpx;
}

/* 推荐流 */
.recommend-section { padding: 20rpx 30rpx; }
.section-title { font-size: 32rpx; font-weight: bold; color: #333; margin-bottom: 20rpx; }
.recommend-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
}
.rec-item {
    width: 48%;
    background: white;
    border-radius: 12rpx;
    padding: 20rpx;
    box-sizing: border-box;
    margin-bottom: 20rpx;
}
.rec-img { width: 100%; height: 200rpx; background: #f5f5f5; border-radius: 8rpx; margin-bottom: 16rpx; }
.rec-name { font-size: 28rpx; color: #333; margin-bottom: 8rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rec-price { font-size: 30rpx; font-weight: bold; color: #ff5722; }