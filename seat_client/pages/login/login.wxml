<view class="container">
    <view class="header">
        <image class="logo" src="/assets/images/seat-active.png" mode="aspectFit"></image>
        <view class="title">智座 SmartSeat</view>
        <view class="subtitle">高校图书馆座位智能预约系统</view>
    </view>

    <view class="form-area">
        <view class="input-group">
            <view class="label">学号</view>
            <input class="input" type="number" placeholder="请输入学号"
                   model:value="{{studentId}}" bindinput="handleInput" data-field="studentId"/>
        </view>

        <view class="input-group">
            <view class="label">密码</view>
            <input class="input" password type="text" placeholder="请输入密码"
                   model:value="{{password}}" bindinput="handleInput" data-field="password"/>
        </view>

        <button class="btn-login" bindtap="handleLogin" loading="{{loading}}">登 陆</button>
        <view class="link-area">
            <text class="register-link" bindtap="handleRegister">没有账号？去注册</text>
        </view>
    </view>
</view>