<view class="container">
    <view class="header">
        <image class="logo" src="/assets/images/cart.png" mode="aspectFit"></image>
        <view class="title">瑞幸咖啡</view>
        <view class="subtitle">{{isRegister ? '欢迎注册' : '欢迎登录'}}</view>
    </view>

    <view class="form-area">
        <view class="input-group">
            <view class="label">手机号</view>
            <input class="input" type="number" placeholder="请输入手机号" maxlength="11"
                   value="{{phone}}" bindinput="handleInput" data-field="phone"/>
        </view>

        <view class="input-group" wx:if="{{isRegister}}">
            <view class="label">姓名</view>
            <input class="input" type="text" placeholder="请输入姓名"
                   value="{{name}}" bindinput="handleInput" data-field="name"/>
        </view>

        <view class="input-group">
            <view class="label">密码</view>
            <input class="input" type="password" placeholder="{{isRegister ? '请设置密码（至少6位）' : '请输入密码'}}"
                   value="{{password}}" bindinput="handleInput" data-field="password"/>
        </view>

        <button class="btn-login" bindtap="{{isRegister ? 'handleRegister' : 'handleLogin'}}" 
                loading="{{loading}}">
            {{isRegister ? '注册' : '登录'}}
        </button>
        
        <view class="link-area">
            <text class="register-link" bindtap="switchMode">
                {{isRegister ? '已有账号？去登录' : '没有账号？去注册'}}
            </text>
        </view>
    </view>

    <!-- 答辩演示模式登录按钮 -->
    <view class="mock-login-area">
        <button class="btn-mock" bindtap="handleMockLogin">
            🎓 答辩演示模式 (免验证)
        </button>
    </view>

    <!-- 账号密码登录区域（答辩演示专用） -->
    <view class="divider-area">
        <view class="divider-line"></view>
        <text class="divider-text">或使用账号密码登录</text>
        <view class="divider-line"></view>
    </view>

    <view class="account-form-area">
        <view class="input-group">
            <view class="label">用户名</view>
            <input class="input" type="text" placeholder="请输入用户名（3-20个字符）" 
                   value="{{accountUsername}}" bindinput="handleInput" data-field="accountUsername"/>
        </view>

        <view class="input-group" wx:if="{{isAccountRegister}}">
            <view class="label">昵称</view>
            <input class="input" type="text" placeholder="请输入昵称" 
                   value="{{accountNickname}}" bindinput="handleInput" data-field="accountNickname"/>
        </view>

        <view class="input-group">
            <view class="label">密码</view>
            <input class="input" type="password" placeholder="{{isAccountRegister ? '请设置密码（至少6位）' : '请输入密码'}}" 
                   value="{{accountPassword}}" bindinput="handleInput" data-field="accountPassword"/>
        </view>

        <button class="btn-account" bindtap="{{isAccountRegister ? 'handleAccountRegister' : 'handleAccountLogin'}}" 
                loading="{{accountLoading}}">
            {{isAccountRegister ? '注册账号' : '账号登录'}}
        </button>
        
        <view class="link-area">
            <text class="register-link" bindtap="switchAccountMode">
                {{isAccountRegister ? '已有账号？去登录' : '没有账号？去注册'}}
            </text>
        </view>
    </view>
</view>