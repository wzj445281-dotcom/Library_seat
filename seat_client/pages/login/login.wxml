<view class="container">
    <view class="header">
        <image class="logo" src="/assets/images/cart.png" mode="aspectFit"></image>
        <view class="title">瑞幸咖啡</view>
        <view class="subtitle">{{isRegister ? '新用户注册' : '欢迎回来'}}</view>
    </view>

    <view class="form-area">
        <view class="input-group">
            <view class="label">手机号</view>
            <input
                    class="input"
                    type="number"
                    placeholder="请输入手机号"
                    maxlength="11"
                    value="{{phone}}"
                    bindinput="handleInput"
                    data-field="phone"
            />
        </view>

        <view class="input-group" wx:if="{{isRegister}}">
            <view class="label">昵称</view>
            <input
                    class="input"
                    type="text"
                    placeholder="怎么称呼您"
                    maxlength="10"
                    value="{{name}}"
                    bindinput="handleInput"
                    data-field="name"
            />
        </view>

        <view class="input-group">
            <view class="label">密码</view>
            <input
                    class="input"
                    type="password"
                    placeholder="{{isRegister ? '设置登录密码 (6-20位)' : '请输入登录密码'}}"
                    maxlength="20"
                    value="{{password}}"
                    bindinput="handleInput"
                    data-field="password"
            />
        </view>

        <button
                class="btn-submit"
                bindtap="{{isRegister ? 'handleRegister' : 'handleLogin'}}"
                loading="{{loading}}"
        >
            {{isRegister ? '立即注册' : '立即登录'}}
        </button>

        <view class="link-area">
            <view class="mode-switch" bindtap="switchMode">
                <text>{{isRegister ? '已有账号？' : '还没有账号？'}}</text>
                <text class="highlight">{{isRegister ? '去登录' : '去注册'}}</text>
            </view>
        </view>
    </view>

    <view class="footer">
        登录代表您已同意 <text class="protocol">《瑞幸咖啡用户协议》</text>
    </view>
</view>