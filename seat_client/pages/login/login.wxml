<view class="container">
    <view class="header">
        <image class="logo" src="/assets/images/seat-active.png" mode="aspectFit"></image>
        <view class="title">瑞幸咖啡</view>
        <view class="subtitle">{{isRegister ? '欢迎注册' : '欢迎登录'}}</view>
    </view>

    <view class="form-area">
        <view class="input-group">
            <view class="label">手机号</view>
            <input class="input" type="number" placeholder="请输入手机号" maxlength="11"
                   value="{{phone}}" bindinput="handleInput" data-field="phone"/>
        </view>

        <view class="input-group" wx:if="{{isRegister}}">
            <view class="label">姓名</view>
            <input class="input" type="text" placeholder="请输入姓名"
                   value="{{name}}" bindinput="handleInput" data-field="name"/>
        </view>

        <view class="input-group">
            <view class="label">验证码</view>
            <view class="code-row">
                <input class="input code-input" type="number" placeholder="请输入验证码" maxlength="6"
                       value="{{code}}" bindinput="handleInput" data-field="code"/>
                <button class="code-btn {{countdown > 0 ? 'disabled' : ''}}" 
                        bindtap="sendCode" disabled="{{countdown > 0}}">
                    {{codeText}}
                </button>
            </view>
        </view>

        <button class="btn-login" bindtap="{{isRegister ? 'handleRegister' : 'handleLogin'}}" 
                loading="{{loading}}">
            {{isRegister ? '注册' : '登录'}}
        </button>
        
        <view class="link-area">
            <text class="register-link" bindtap="switchMode">
                {{isRegister ? '已有账号？去登录' : '没有账号？去注册'}}
            </text>
        </view>
    </view>
</view>