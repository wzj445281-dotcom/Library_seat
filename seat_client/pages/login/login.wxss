page {
    background-color: #fff;
}
.container {
    padding: 60rpx 40rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
}
.header {
    margin-top: 60rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 80rpx;
}
.logo {
    width: 120rpx;
    height: 120rpx;
    margin-bottom: 20rpx;
}
.title {
    font-size: 40rpx;
    font-weight: bold;
    color: #333;
}
.subtitle {
    font-size: 24rpx;
    color: #999;
    margin-top: 10rpx;
    letter-spacing: 2rpx;
}

.form-area {
    width: 100%;
}
.input-group {
    margin-bottom: 40rpx;
}
.label {
    font-size: 28rpx;
    color: #666;
    margin-bottom: 15rpx;
}
.input {
    background: #f7f8fa;
    height: 90rpx;
    padding: 0 30rpx;
    border-radius: 12rpx;
    font-size: 30rpx;
}

.btn-login {
    background: #1296db;
    color: #fff;
    border-radius: 50rpx;
    margin-top: 60rpx;
    font-size: 32rpx;
    font-weight: bold;
    box-shadow: 0 6rpx 20rpx rgba(18, 150, 219, 0.3);
}

.link-area {
    margin-top: 30rpx;
    text-align: center;
}
.register-link {
    color: #1296db;
    font-size: 26rpx;
}