page {
    background-color: #fff;
    font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', sans-serif;
}

.container {
    padding: 60rpx 60rpx;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    box-sizing: border-box;
}

/* --- 头部 --- */
.header {
    margin-top: 40rpx;
    margin-bottom: 80rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* 如果想左对齐，去掉 align-items: center，并加上 align-items: flex-start */
}

.logo {
    width: 140rpx;
    height: 140rpx;
    margin-bottom: 30rpx;
}

.title {
    font-size: 44rpx;
    font-weight: 800; /* 加粗 */
    color: #0022AB;   /* 瑞幸蓝 */
    margin-bottom: 10rpx;
    letter-spacing: 2rpx;
}

.subtitle {
    font-size: 26rpx;
    color: #999;
    letter-spacing: 4rpx;
}

/* --- 表单 --- */
.form-area {
    width: 100%;
}

.input-group {
    margin-bottom: 40rpx;
}

.label {
    font-size: 28rpx;
    color: #333;
    font-weight: bold;
    margin-bottom: 16rpx;
    padding-left: 4rpx;
}

.input {
    background: #f7f8fa;
    height: 100rpx;
    padding: 0 30rpx;
    border-radius: 16rpx;
    font-size: 30rpx;
    color: #333;
    transition: all 0.3s;
    border: 2rpx solid transparent;
}

/* 输入框聚焦态 - 瑞幸蓝边框 */
.input:focus {
    background: #fff;
    border-color: #0022AB;
    box-shadow: 0 0 10rpx rgba(0, 34, 171, 0.1);
}

/* --- 按钮 --- */
.btn-submit {
    margin-top: 80rpx;
    height: 100rpx;
    line-height: 100rpx;
    background: #0022AB; /* 纯色瑞幸蓝更显高级 */
    color: #fff;
    border-radius: 50rpx;
    font-size: 34rpx;
    font-weight: bold;
    box-shadow: 0 10rpx 30rpx rgba(0, 34, 171, 0.25);
    letter-spacing: 4rpx;
}

.btn-submit:active {
    transform: scale(0.98);
    opacity: 0.9;
}

/* --- 底部切换 --- */
.link-area {
    margin-top: 40rpx;
    text-align: center;
}

.mode-switch {
    font-size: 28rpx;
    color: #666;
    padding: 20rpx; /* 增加点击区域 */
}

.highlight {
    color: #0022AB;
    font-weight: bold;
    margin-left: 10rpx;
}

/* --- 底部协议 --- */
.footer {
    margin-top: auto; /* 推到底部 */
    text-align: center;
    font-size: 24rpx;
    color: #ccc;
    padding-bottom: 40rpx;
}

.protocol {
    color: #0022AB;
}