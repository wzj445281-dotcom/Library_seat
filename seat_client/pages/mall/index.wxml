<view class="container">
    <!-- 头部：强调激励与荣誉 -->
    <view class="header">
        <view class="balance-card">
            <view class="label">我的学习积分</view>
            <view class="value">{{points}}</view>
            <view class="sub-label">良好的信用是您最大的财富</view>
        </view>
        <view class="stats-row">
            <view class="stat-item">
                <text class="num">{{exchangeCount || 0}}</text>
                <text class="txt">已兑换权益</text>
            </view>
            <view class="stat-item">
                <text class="num">{{rank || '-'}}</text>
                <text class="txt">全校排名</text>
            </view>
        </view>
    </view>

    <!-- 分类 Tabs：更学术化的命名 -->
    <view class="tabs">
        <view class="tab {{activeTab==0?'active':''}}" bindtap="switchTab" data-idx="0">
            <text>特权服务</text> <!-- 原虚拟权益 -->
        </view>
        <view class="tab {{activeTab==1?'active':''}}" bindtap="switchTab" data-idx="1">
            <text>学习补给</text> <!-- 原实物商品 -->
        </view>
    </view>

    <!-- 商品列表 -->
    <scroll-view scroll-y class="product-list">
        <view class="list-container">
            <block wx:for="{{products}}" wx:key="id">
                <view class="product-card">
                    <!-- 左侧图片/图标 -->
                    <view class="img-box">
                        <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"></image>
                        <view wx:else class="placeholder-icon">{{activeTab==0 ? '👑' : '📚'}}</view>
                    </view>

                    <!-- 中间信息 -->
                    <view class="info-box">
                        <view class="title">{{item.name}}</view>
                        <view class="desc">{{item.description}}</view>
                        <view class="stock-tag" wx:if="{{item.stock < 10 && item.stock > 0}}">仅剩 {{item.stock}} 份</view>
                    </view>

                    <!-- 右侧兑换按钮 -->
                    <view class="action-box">
                        <view class="point-text">{{item.price}} 积分</view>
                        <button class="btn-exchange {{item.stock <= 0 ? 'disabled' : ''}}"
                                bindtap="handleExchange"
                                data-id="{{item.id}}"
                                disabled="{{item.stock <= 0}}">
                            {{item.stock > 0 ? '兑换' : '已兑完'}}
                        </button>
                    </view>
                </view>
            </block>

            <!-- 空状态 -->
            <view wx:if="{{products.length === 0}}" class="empty-tip">
                暂无可用权益，去图书馆学习赚积分吧~
            </view>
        </view>
    </scroll-view>
</view>